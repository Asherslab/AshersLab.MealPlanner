@*
    One group of pages on More or Settings - a drawer of the fridge door: one pad sheet, the group's name on its head
    band, a ruled row per page - its icon in the pad's green, its name and one line saying what it is for, a chevron.
    Each row is a plain link the full width of the sheet, so the whole row is the tap target.
*@

<div class="destination-group">
    <PadSheet Title="@Heading">
        @foreach (NavDestination d in Destinations)
        {
            <a href="@d.Route" class="destination-row" data-testid="@TestIdPrefix-@d.Key">
                <MudIcon Icon="@d.Icon" Color="Color.Primary" Class="destination-icon"/>
                <span class="destination-text">
                    <span class="destination-title">@d.Title</span>
                    <span class="destination-description">@d.Description</span>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="destination-chevron"/>
            </a>
        }
    </PadSheet>
</div>

@code {
    [Parameter] public string? Heading { get; set; }

    [Parameter, EditorRequired] public IEnumerable<NavDestination> Destinations { get; set; } = [];

    /// <summary><c>more</c> or <c>settings</c>: each row's testid is the prefix and the page's key.</summary>
    [Parameter, EditorRequired] public string TestIdPrefix { get; set; } = "";
}
