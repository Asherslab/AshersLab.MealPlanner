@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

@*
    The menu is a drawer, not buttons in the app bar: on a phone the bar has room for the menu button, the title
    and the sync chip, and nothing else. Wide screens keep it open beside the page; narrow ones slide it over and
    close it when a page is picked.
*@
<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Menu" OnClick="() => _drawerOpen = !_drawerOpen" data-testid="nav-menu"/>
        <MudLink Href="" Color="Color.Inherit" Underline="Underline.None" Typo="Typo.h6">Meal Planner</MudLink>
        <MudSpacer/>
        <SyncStatusChip/>
        <ServerReplacedPrompt/>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1"
               Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home"
                        data-testid="nav-home">Home</MudNavLink>
            <MudNavLink Href="calendar" Icon="@Icons.Material.Filled.CalendarMonth"
                        data-testid="nav-calendar">Calendar</MudNavLink>
            <MudNavLink Href="plans"Icon="@Icons.Material.Filled.CalendarViewWeek"
                        data-testid="nav-plans">Plans</MudNavLink>
            <MudNavLink Href="shopping" Icon="@Icons.Material.Filled.ShoppingCart"
                        data-testid="nav-shopping">Shopping</MudNavLink>
            <MudNavLink Href="pantry" Icon="@Icons.Material.Filled.Kitchen"
                        data-testid="nav-pantry">Pantry</MudNavLink>
            <MudNavLink Href="receipts" Icon="@Icons.Material.Filled.Receipt"
                        data-testid="nav-receipts">Receipts</MudNavLink>
            <MudNavLink Href="meals" Icon="@Icons.Material.Filled.RestaurantMenu"
                        data-testid="nav-meals">Meals</MudNavLink>
            <MudNavLink Href="ingredients" Icon="@Icons.Material.Filled.Egg"
                        data-testid="nav-ingredients">Ingredients</MudNavLink>
            <MudNavLink Href="prices" Icon="@Icons.Material.Filled.Sell"
                        data-testid="nav-prices">Prices</MudNavLink>
            <MudNavLink Href="people" Icon="@Icons.Material.Filled.People"
                        data-testid="nav-people">People</MudNavLink>
            <MudNavLink Href="slots" Icon="@Icons.Material.Filled.Schedule"
                        data-testid="nav-slots">Slots of the day</MudNavLink>
            <MudNavLink Href="meal-groups" Icon="@Icons.Material.Filled.ViewList"
                        data-testid="nav-meal-groups">Meal groups</MudNavLink>
            <MudNavLink Href="categories" Icon="@Icons.Material.Filled.Category"
                        data-testid="nav-categories">Categories</MudNavLink>
            <MudNavLink Href="stores" Icon="@Icons.Material.Filled.Storefront"
                        data-testid="nav-stores">Stores</MudNavLink>
            <MudNavLink Href="import" Icon="@Icons.Material.Filled.UploadFile"
                        data-testid="nav-import">Import spreadsheet</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pt-14">
        <MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    // A responsive drawer closes itself below its breakpoint, so this is open on a desktop and closed on a phone.
    private bool _drawerOpen = true;

    [Inject] private IBrowserViewportService Viewport { get; set; } = null!;
    [Inject] private NavigationManager       Navigation { get; set; } = null!;

    // On any navigation, not on the menu link's click: MudNavLink's OnClick never reached this on a phone (seen
    // 2026-10-22 - the menu stayed over the page it had just opened), and a link inside a page should close it too.
    protected override void OnInitialized() => Navigation.LocationChanged += ClosedOnPhone;

    private async void ClosedOnPhone(object? sender, LocationChangedEventArgs e)
    {
        if (!_drawerOpen || await Viewport.GetCurrentBreakpointAsync() >= Breakpoint.Md)
            return;
        _drawerOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= ClosedOnPhone;
}
