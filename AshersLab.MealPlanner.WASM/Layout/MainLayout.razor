@inherits LayoutComponentBase

<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudLink Href="" Color="Color.Inherit" Underline="Underline.None" Typo="Typo.h6">Meal Planner</MudLink>
        <MudButton Href="ingredients" Color="Color.Inherit" Variant="Variant.Text" Class="ml-4"
                   data-testid="nav-ingredients">Ingredients</MudButton>
        <MudSpacer/>
        <SyncStatusChip/>
    </MudAppBar>
    <MudMainContent Class="pt-14">
        <MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
