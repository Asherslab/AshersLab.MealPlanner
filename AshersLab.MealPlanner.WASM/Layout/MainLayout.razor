@inherits LayoutComponentBase
@implements IDisposable

@* The fridge-door pad in the kitchen bench's colours: Design/AppTheme.cs. *@
<MudThemeProvider Theme="AppTheme.Theme"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

@*
    Two ways around, both read from NavModel so they list the same pages. A phone has the bottom bar (Today, Plan,
    Shop, Meals, More) and, on a page reached through More or Settings, a back arrow in the app bar; no drawer. From
    Md up there is no bottom bar, and the drawer sits open beside the page: the four daily pages, Kitchen, Settings.
    Which one shows is plain CSS (MainLayout.razor.css, BottomNav.razor.css), not the viewport service, so the first
    paint is already right.
*@
<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="app-bar">
        <span class="wide-only">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           aria-label="Menu" OnClick="() => _drawerOpen = !_drawerOpen" data-testid="nav-menu"/>
        </span>
        @if (_back is not null && _here is not null)
        {
            <span class="phone-only app-bar-page">
                <MudIconButton Href="@Link(_back)" Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit"
                               Edge="Edge.Start" aria-label="@($"Back to {_back.Title}")" data-testid="app-back"/>
                <MudText Typo="Typo.h6" Class="app-bar-title">@_here.Title</MudText>
            </span>
            <span class="wide-only">
                <MudLink Href="./" Color="Color.Inherit" Underline="Underline.None" Typo="Typo.h6">Meal Planner</MudLink>
            </span>
        }
        else if (_here is { TabLabel: { } tab, Route.Length: > 0 })
        {
            @* A tab other than Today: the bar names it on a phone, as the bottom bar does; the app's name on a desktop. *@
            <span class="phone-only app-bar-page">
                <MudText Typo="Typo.h6" Class="app-bar-title">@tab</MudText>
            </span>
            <span class="wide-only">
                <MudLink Href="./" Color="Color.Inherit" Underline="Underline.None" Typo="Typo.h6">Meal Planner</MudLink>
            </span>
        }
        else
        {
            <MudLink Href="./" Color="Color.Inherit" Underline="Underline.None" Typo="Typo.h6">Meal Planner</MudLink>
        }
        <MudSpacer/>
        <SyncStatusChip/>
        <ServerReplacedPrompt/>
    </MudAppBar>
    @* Responsive: open beside the page from Md up, and closed below it - where nothing opens it. *@
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="app-drawer"
               Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md">
        <MudNavMenu>
            @foreach (NavDestination d in NavModel.In(NavGroup.Main))
            {
                <MudNavLink Href="@Link(d)" Match="@(d.Route.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                            Icon="@d.Icon" data-testid="@($"nav-{d.Key}")">@(d.TabLabel ?? d.Title)</MudNavLink>
            }
            <div class="drawer-heading">
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Kitchen</MudText>
            </div>
            @foreach (NavDestination d in NavModel.In(NavGroup.Kitchen))
            {
                <MudNavLink Href="@Link(d)" Icon="@d.Icon" data-testid="@($"nav-{d.Key}")">@d.Title</MudNavLink>
            }
            <MudDivider Class="my-2"/>
            @foreach (NavDestination d in NavModel.In(NavGroup.Settings))
            {
                <MudNavLink Href="@Link(d)" Icon="@d.Icon" data-testid="@($"nav-{d.Key}")">@d.Title</MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pt-14">
        <MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
            <div class="page-body">
                @Body
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<BottomNav Active="_tab"/>

@code {
    // A responsive drawer closes itself below its breakpoint, so this is open on a desktop and closed on a phone.
    private bool _drawerOpen = true;

    private NavDestination? _here;
    private NavDestination? _back;
    private NavDestination? _tab;

    [Inject] private NavigationManager Navigation { get; set; } = null!;

    // The bar and the back arrow follow every navigation, wherever it came from - a tab, a row on More, a link
    // inside a page, the browser's own back button.
    protected override void OnInitialized()
    {
        Locate();
        Navigation.LocationChanged += Moved;
    }

    private void Moved(object? sender, LocationChangedEventArgs e)
    {
        Locate();
        InvokeAsync(StateHasChanged);
    }

    private void Locate()
    {
        string path = Navigation.ToBaseRelativePath(Navigation.Uri);
        _here = NavModel.Find(path);
        _back = NavModel.BackFrom(path);
        _tab  = NavModel.TabFor(path);
    }

    // "./" rather than "" for Today: an empty href is the current page, not the app's base (Home Assistant's ingress
    // path, under the add-on).
    private static string Link(NavDestination d) => d.Route.Length == 0 ? "./" : d.Route;

    public void Dispose() => Navigation.LocationChanged -= Moved;
}
