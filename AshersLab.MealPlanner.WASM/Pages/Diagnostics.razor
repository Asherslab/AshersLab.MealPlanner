@page "/settings/diagnostics"
@using AshersLab.MealPlanner.LocalData
@using AshersLab.MealPlanner.Shared.Contracts.Entities.Features.Server
@using AshersLab.MealPlanner.Shared.Contracts.Services.Features.Server
@using AshersLab.MealPlanner.WASM.Data
@inherits LocalDataPage
@inject IServerInfoService ServerInfoService

@*
    For when something is wrong: whether this browser's copy of the data opened (and the reset when it did not), the
    server's version and newest migration, and this device's row. A LocalDataPage only for the gate - it reads nothing.
    Two quiet sheets - a plain band, ruled rows of label and value - so it reads as the back of the pad, not daily work.
*@

<PageTitle>Diagnostics - Meal Planner</PageTitle>

<div class="diagnostics">
    <h1 class="page-title">Diagnostics</h1>

    @* Shows nothing once the database is open; when it failed, the error and the reset offer the device sheet points at. *@
    <LocalDataGate Start="Start"/>

    <PadSheet Title="Server" Class="quiet">
        <Head>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" aria-label="Check the server again"
                           Disabled="_loading" OnClick="Load"/>
        </Head>
        <ChildContent>
            @if (_loading)
            {
                <div class="diag-note">
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
                </div>
            }
            else if (_error is not null)
            {
                <div class="diag-note">
                    <MudAlert Severity="Severity.Error" Dense="true">Could not reach the server: @_error</MudAlert>
                </div>
            }
            else if (_info is not null)
            {
                <PadRow Label="Version">
                    <span class="diag-value" data-testid="server-version">@_info.Version</span>
                </PadRow>
                <PadRow Label="Server time">
                    <span class="diag-value num" data-testid="server-time">@_info.ServerTimeUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                </PadRow>
                <PadRow Label="Database">
                    <span class="diag-value" data-testid="server-migration">@(_info.LatestMigration ?? "not migrated")</span>
                </PadRow>
                <PadRow Label="Signed in as">
                    <span class="diag-value" data-testid="server-user">
                        @if (_info.UserName is null)
                        {
                            <span>nobody - not opened through Home Assistant</span>
                        }
                        else
                        {
                            <span>@(_info.UserDisplayName ?? _info.UserName) (@_info.UserName)</span>
                        }
                    </span>
                </PadRow>
            }
        </ChildContent>
    </PadSheet>

    <div class="mt-4">
        <ThisDeviceCard/>
    </div>
</div>

@code {
    private ServerInfo? _info;
    private string?     _error;
    private bool        _loading;

    protected override Task OnInitializedAsync() => Load();

    protected override Task LoadAsync(LocalDbContext db) => Task.CompletedTask;

    private async Task Load()
    {
        _loading = true;
        _error   = null;

        try
        {
            _info = await ServerInfoService.Get();
        }
        catch (Exception ex)
        {
            _info  = null;
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
