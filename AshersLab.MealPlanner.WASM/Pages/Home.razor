@page "/"
@using AshersLab.MealPlanner.Shared.Contracts.Entities.Features.Server
@using AshersLab.MealPlanner.Shared.Contracts.Services.Features.Server
@inject IServerInfoService ServerInfoService

@*
    The scaffold's proof of wiring: one gRPC-Web call from the browser to the host, which answers from its
    SQLite database, and the browser's own SQLite below it. Replaced by the real landing page once there is
    something to plan.
*@

<PageTitle>Meal Planner</PageTitle>

<MudText Typo="Typo.h5" Component="h1">Meal Planner</MudText>
<MudText Class="mt-1 mb-4" Color="Color.Secondary">Nothing to plan yet - this page only checks the server.</MudText>

<MudCard Outlined="true">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Server</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Check the server again"
                           Disabled="_loading" OnClick="Load"/>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Error">Could not reach the server: @_error</MudAlert>
        }
        else if (_info is not null)
        {
            <MudSimpleTable Dense="true" Elevation="0">
                <tbody>
                <tr>
                    <th scope="row">Version</th>
                    <td data-testid="server-version">@_info.Version</td>
                </tr>
                <tr>
                    <th scope="row">Server time</th>
                    <td data-testid="server-time">@_info.ServerTimeUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                </tr>
                <tr>
                    <th scope="row">Database</th>
                    <td data-testid="server-migration">@(_info.LatestMigration ?? "not migrated")</td>
                </tr>
                <tr>
                    <th scope="row">Signed in as</th>
                    <td data-testid="server-user">
                        @if (_info.UserName is null)
                        {
                            <span>nobody - not opened through Home Assistant</span>
                        }
                        else
                        {
                            <span>@(_info.UserDisplayName ?? _info.UserName) (@_info.UserName)</span>
                        }
                    </td>
                </tr>
                </tbody>
            </MudSimpleTable>
        }
    </MudCardContent>
</MudCard>

<div class="mt-4">
    <ThisDeviceCard/>
</div>

@code {
    private ServerInfo? _info;
    private string?     _error;
    private bool        _loading;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _loading = true;
        _error   = null;

        try
        {
            _info = await ServerInfoService.Get();
        }
        catch (Exception ex)
        {
            _info  = null;
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
