@using AshersLab.MealPlanner.WASM.Data
@using SqliteWasmBlazor
@implements IDisposable
@inject SyncLoop Sync
@inject LocalDatabase Database

@*
    Whether this browser's edits have reached the server. In the app bar, so it is visible on every page - the
    planner in a shop with no signal needs to know their ticks are waiting, not lost. Tapping it syncs now.
*@

<MudTooltip Text="@(Sync.Status.Note ?? Tooltip(Sync.Status))">
    @* Outlined, and the app bar's own text colour when nothing is wrong: a Text chip's default is dark on the bar. *@
    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@ColorFor(Sync.Status)"
             Style="@(ColorFor(Sync.Status) == Color.Inherit ? "color: inherit; border-color: currentColor" : null)"
             Icon="@IconFor(Sync.Status)" OnClick="Tapped"
             data-testid="sync-status" data-state="@Sync.Status.Connection.ToString().ToLowerInvariant()"
             data-pending="@Sync.Status.Pending">
        @Label(Sync.Status)
    </MudChip>
</MudTooltip>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    protected override void OnInitialized() => Sync.StatusChanged += Changed;

    /// <summary>
    /// Syncs now - or, signed out, opens Sign in (which, where a proxy does the signing in, says to reload: the page load
    /// then reaches the proxy's login).
    /// </summary>
    private void Tapped()
    {
        if (Sync.Status.Connection == SyncConnection.SignedOut)
            Navigation.NavigateTo($"sign-in?back={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
        else
            Sync.Kick();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // The layout is on every page, so this is where the loop starts. StartAsync is cached: every caller in
        // this window waits on the same start.
        LocalDatabaseStart start = await Database.StartAsync();
        if (start is { State: DbInitState.READY, Device: { } device })
            Sync.Start(device.Id);
    }

    private Task Changed() => InvokeAsync(StateHasChanged);

    public void Dispose() => Sync.StatusChanged -= Changed;

    private static string Label(SyncStatus s) => s.Connection switch
    {
        SyncConnection.Refused                      => "Update needed",
        SyncConnection.SignedOut                    => "Signed out",
        SyncConnection.WaitingForChoice             => "Paused · needs you",
        SyncConnection.Failed when s.Pending > 0    => $"Sync problem · {s.Pending} waiting",
        SyncConnection.Failed                       => "Sync problem",
        SyncConnection.Offline when s.Pending > 0   => $"Offline · {s.Pending} waiting",
        SyncConnection.Offline                      => "Offline",
        _ when s.Pending > 0                        => $"Saving {s.Pending}",
        SyncConnection.Connecting                   => "Connecting",
        _                                           => "Synced",
    };

    private static string Tooltip(SyncStatus s) => s.Connection switch
    {
        SyncConnection.Offline => "Can't reach the server. Changes are kept on this device and sent when it can.",
        SyncConnection.SignedOut => "The sign-in has expired. Tap to reload and sign in again; changes are kept on this device.",
        SyncConnection.WaitingForChoice => "The server started again from empty. Nothing syncs until you choose what to do with this device's copy.",
        _ when s.LastSyncedAt is { } at => $"Last synced {at:HH:mm:ss}. Tap to sync now.",
        _ => "Tap to sync now.",
    };

    private static Color ColorFor(SyncStatus s) => s.Connection switch
    {
        SyncConnection.Refused or SyncConnection.Failed => Color.Error,
        SyncConnection.Offline or SyncConnection.WaitingForChoice or SyncConnection.SignedOut => Color.Warning,
        _ when s.Note is not null => Color.Warning,
        _ => Color.Inherit,
    };

    private static string IconFor(SyncStatus s) => s.Connection switch
    {
        SyncConnection.Refused => Icons.Material.Filled.SystemUpdate,
        SyncConnection.Failed  => Icons.Material.Filled.SyncProblem,
        SyncConnection.Offline => Icons.Material.Filled.CloudOff,
        SyncConnection.SignedOut => Icons.Material.Filled.Login,
        SyncConnection.WaitingForChoice => Icons.Material.Filled.PauseCircle,
        _ when s.Pending > 0   => Icons.Material.Filled.CloudUpload,
        _                      => Icons.Material.Filled.CloudDone,
    };
}
