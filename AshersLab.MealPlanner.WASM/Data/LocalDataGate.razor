@using SqliteWasmBlazor
@inject LocalDatabase Database
@inject IDialogService Dialogs

@*
    What a LocalDataPage shows until the browser database has opened, or when it could not - with the way out. The
    failure is a sheet of its own, said plainly in big print with the technical reason small under it, and the reset
    on the same sheet: nothing else on the page works until it is dealt with.
*@

@if (Start is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4"/>
}
else if (Start.State != DbInitState.READY)
{
    <div class="db-failure">
        <PadSheet>
            <div class="db-failure-body">
                <h2 class="db-failure-title">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Class="db-failure-icon"/>
                    The meal planner can't open its data on this device
                </h2>
                <p class="db-failure-state" data-testid="local-db-state">
                    This browser could not open its copy of the data.
                    <span class="db-failure-detail">(@Start.State): @Start.Failure</span>
                </p>
            </div>
            @if (Start.CanReset)
            {
                <div class="db-reset" data-testid="local-db-reset-offer">
                    @if (_resetting)
                    {
                        <p class="db-reset-text">Resetting this device's copy…</p>
                        <MudProgressLinear Indeterminate="true" Color="Color.Error"/>
                    }
                    else
                    {
                        <p class="db-reset-text">
                            Try reloading the page first. If that doesn't help, reset this device's copy: it is deleted and
                            everything is downloaded again from the server.
                        </p>
                        @if (_resetFailure is not null)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" data-testid="local-db-reset-failure">
                                @_resetFailure
                            </MudAlert>
                        }
                        <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt"
                                   Disabled="_asking" OnClick="AskToReset" data-testid="local-db-reset">Reset this device's copy</MudButton>
                    }
                </div>
            }
        </PadSheet>
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter, EditorRequired] public LocalDatabaseStart? Start { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool    _asking;
    private bool    _resetting;
    private string? _resetFailure;

    private async Task AskToReset()
    {
        _asking = true;
        int? unsent = await Database.CountUnsentAsync();
        _asking = false;

        DialogParameters<ResetDeviceDialog> parameters = new() { { d => d.Unsent, unsent } };
        DialogOptions options = new() { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false };
        IDialogReference dialog = await Dialogs.ShowAsync<ResetDeviceDialog>("Reset this device's copy?", parameters, options);
        if (await dialog.Result is not { Canceled: false })
            return;

        _resetting    = true;
        _resetFailure = null;
        StateHasChanged();

        // Returns only if it failed: on success the page reloads into a fresh copy.
        _resetFailure = await Database.ResetAsync();
        _resetting    = false;
    }
}
