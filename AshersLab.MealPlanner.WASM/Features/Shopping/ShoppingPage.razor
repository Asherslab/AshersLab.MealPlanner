@page "/shopping"
@using AshersLab.MealPlanner.LocalData
@using AshersLab.MealPlanner.LocalData.Sync
@using AshersLab.MealPlanner.Shared.Data.Shopping
@using AshersLab.MealPlanner.Shared.Data.Stores
@using AshersLab.MealPlanner.Shared.Data.Sync
@using AshersLab.MealPlanner.Shared.Domain
@using AshersLab.MealPlanner.Shared.Domain.Meals
@using AshersLab.MealPlanner.Shared.Domain.Planning
@using AshersLab.MealPlanner.Shared.Domain.Prices
@using AshersLab.MealPlanner.Shared.Domain.Shopping
@using AshersLab.MealPlanner.Shared.Domain.Sync
@using AshersLab.MealPlanner.WASM.Data
@using Microsoft.EntityFrameworkCore
@inherits LocalDataPage
@inject NavigationManager Navigation

@*
    The shopping list, used one-handed in a shop with poor reception. Every line is the week's meals less the pantry, in
    whole packs, under its usual store and category (ShoppingBook - computed here, from this browser's own database, so it
    works offline). Tap a line - the whole row - to tick it bought; "Have" says it is already in the kitchen. Ticks are ops
    like any edit: queued offline, synced when the phone is back in reception, shown on every other device. Below: extra
    items typed by hand, what the pantry already covers (to check), and the other lists.

    It is a ruled list pad torn into one sheet per store. A ticked line stays where it was under the marker line; one not
    yet on the server has a dashed edge. Each category's lines sit in a bare MudPaper only because the shopping check
    finds a line's store by walking back from `.mud-paper` to the store's heading - it draws nothing.
*@

<PageTitle>Shopping - Meal Planner</PageTitle>

<LocalDataGate Start="Start">
<div class="shop">
    <section class="pad shop-head" data-testid="shop-head">
        <header class="pad-head">
            <h1 data-testid="shop-range" title="@ShoppingText.Range(_from, _to)">@ShoppingText.ShortRange(_from, _to)</h1>
            <p>
                @if (_book is not null)
                {
                    <span class="shop-eaten-line">The food for these days: <span data-testid="shop-eaten">@_book.Eaten.Format()</span></span>
                }
                else
                {
                    <span>Shopping list</span>
                }
            </p>
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.DateRange"
                       Class="shop-range-edit" OnClick="() => _editingRange = !_editingRange" data-testid="shop-range-edit">Change days</MudButton>
        </header>
        @if (_editingRange)
        {
            <form class="shop-range-form" @onsubmit="ShowRange" @onsubmit:preventDefault data-testid="shop-range-form">
                <label class="native-select">
                    <span>From</span>
                    <input type="date" class="native-date" @bind="_newFrom" data-testid="shop-from"/>
                </label>
                <label class="native-select">
                    <span>To</span>
                    <input type="date" class="native-date" @bind="_newTo" data-testid="shop-to"/>
                </label>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="shop-tall" data-testid="shop-range-save">Show</MudButton>
            </form>
            @if (_rangeError is not null)
            {
                <p class="shop-error" role="alert" data-testid="shop-range-error">@_rangeError</p>
            }
        }
    </section>

    @if (_book is not null)
    {
        (int left, int done) = Counts();
        (string before, string figure, string after) = ShoppingText.Figure(_book.Spend);

        <div class="week-tiles shop-tiles">
            <div class="week-tile">
                <div class="shop-figure" data-testid="shop-progress"><b>@left</b><span>@(" " + ShoppingText.ProgressLabel(left, done))</span></div>
            </div>
            @*
                Nothing to spend - no packs, no extras, no takeaway - says so in words: "$0.00" reads like a price that was
                worked out, beside counts of things unpriced elsewhere.
            *@
            <div class="week-tile">
                @if (_book.Spend is { Cents: 0, Missing: 0 })
                {
                    <div class="shop-figure" data-testid="shop-spend"><b>Nothing</b></div>
                    <span>to spend on these days</span>
                }
                else
                {
                    <div class="shop-figure" data-testid="shop-spend">@if (before.Length > 0)
                        {
                            <span class="shop-figure-from">@before</span>
                        }<b>@figure</b>@if (after.Length > 0)
                        {
                            <span class="shop-figure-more">@after</span>
                        }</div>
                    <span>to spend on this list</span>
                }
            </div>
        </div>

        @if (_book.Groups.Count == 0 && _book.InPantry.Count == 0)
        {
            <section class="pad shop-sheet">
                <p class="pad-note" data-testid="shop-empty">
                    Nothing to buy - the calendar has no meals with ingredients on these days, and no staple is running low.
                    Plan some meals on the <a href="calendar">calendar</a>, or add something below.
                </p>
            </section>
        }

        @foreach (StoreGroup group in _book.Groups)
        {
            <section class="pad shop-sheet" data-testid="shop-sheet" data-id="@group.Store?.Id">
                <h2 class="shop-store" data-testid="shop-store" data-id="@group.Store?.Id">@(group.Store?.Name ?? "Anywhere")</h2>
                @foreach ((var category, IReadOnlyList<ShoppingLine> lines) in group.Categories)
                {
                    <h3 class="shop-category" data-testid="shop-category">@(category?.Name ?? "No category")</h3>
                    <MudPaper Elevation="0" Square="true" Class="shop-lines">
                        @foreach (ShoppingLine line in lines)
                        {
                            bool bought = line.Tick == ShoppingTick.Bought, have = line.Tick == ShoppingTick.HaveIt;
                            <div class="@($"shop-line{(_unsent.Contains(line.ItemId) ? " unsent" : "")}")" @key="line.ItemId"
                                 data-testid="shop-line" data-id="@line.Ingredient.Id" data-tick="@line.Tick" data-need="@line.Plan.Need">
                                <div class="shop-tap" role="checkbox" tabindex="0" aria-checked="@(bought ? "true" : "false")"
                                     aria-label="@($"{line.Ingredient.Name}: bought")" @onclick="() => Tick(line, bought ? ShoppingTick.None : ShoppingTick.Bought)"
                                     data-testid="shop-line-tap">
                                    <span class="shop-box-col">
                                        <span class="@($"shop-box{(bought ? " bought" : have ? " have" : "")}")">
                                            @if (bought || have)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small"/>
                                            }
                                        </span>
                                    </span>
                                    <span class="@($"shop-what{(bought || have ? " struck" : "")}")">
                                        <span class="shop-name" data-testid="shop-line-name">@line.Ingredient.Name</span>
                                        <span class="shop-detail" data-testid="shop-line-detail">@(have ? "have it" : ShoppingText.Detail(line))</span>
                                    </span>
                                    <span class="@($"shop-cost{(line.Plan.Pack?.Cents is null ? " unpriced" : "")}")" data-testid="shop-line-cost">@(have ? "" : ShoppingText.Cost(line))</span>
                                </div>
                                <div class="shop-side">
                                    <MudButton Variant="Variant.Outlined" Color="@(have ? Color.Primary : Color.Default)"
                                               StartIcon="@(have ? Icons.Material.Filled.Check : null)"
                                               Class="@($"shop-have{(have ? " on" : "")}")" aria-pressed="@(have ? "true" : "false")"
                                               aria-label="@($"{line.Ingredient.Name}: have it already")"
                                               OnClick="() => Tick(line, have ? ShoppingTick.None : ShoppingTick.HaveIt)" data-testid="shop-have">Have</MudButton>
                                </div>
                            </div>
                        }
                    </MudPaper>
                }
                @if (group.Extras.Count > 0)
                {
                    <h3 class="shop-category">Extras</h3>
                    <MudPaper Elevation="0" Square="true" Class="shop-lines">
                        @foreach (ShoppingListItem extra in group.Extras)
                        {
                            bool bought = extra.Tick == ShoppingTick.Bought;
                            <div class="@($"shop-line{(_unsent.Contains(extra.Id) ? " unsent" : "")}")" @key="extra.Id"
                                 data-testid="shop-extra" data-id="@extra.Id" data-tick="@extra.Tick">
                                <div class="shop-tap" role="checkbox" tabindex="0" aria-checked="@(bought ? "true" : "false")"
                                     aria-label="@($"{extra.Name}: bought")" @onclick="() => TickExtra(extra)" data-testid="shop-extra-tap">
                                    <span class="shop-box-col">
                                        <span class="@($"shop-box{(bought ? " bought" : "")}")">
                                            @if (bought)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small"/>
                                            }
                                        </span>
                                    </span>
                                    <span class="@($"shop-what{(bought ? " struck" : "")}")">
                                        <span class="marker" data-testid="shop-extra-name">@extra.Name</span>
                                    </span>
                                    <span class="@($"shop-cost{(extra.PriceCents is null ? " unpriced" : "")}")" data-testid="shop-extra-cost">@(extra.PriceCents is { } c ? Money.Format(c) : "unpriced")</span>
                                </div>
                                @* Not a delete button: the right edge is where every ingredient row has Have, under a thumb working down
                                   the list, and a removed extra is gone from every device. A menu makes it two deliberate taps. *@
                                <div class="shop-side">
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="@($"More for {extra.Name}")" AnchorOrigin="Origin.BottomRight"
                                             TransformOrigin="Origin.TopRight" data-testid="shop-extra-more">
                                        <MudMenuItem Icon="@Icons.Material.Filled.DeleteOutline" OnClick="() => RemoveExtra(extra)"
                                                     data-testid="shop-extra-delete">Remove @extra.Name</MudMenuItem>
                                    </MudMenu>
                                </div>
                            </div>
                        }
                    </MudPaper>
                }
            </section>
        }

        <section class="pad shop-add">
            <h2 class="shop-add-title">Add something</h2>
            <form class="shop-add-form" @onsubmit="AddExtra" @onsubmit:preventDefault data-testid="shop-extra-form">
                <div class="shop-add-name">
                    <MudTextField T="string" @bind-Value="_extraName" Label="Bin bags, candles…" Variant="Variant.Outlined"
                                  Immediate="true" MaxLength="Names.MaxLength" InputId="shop-extra-new-name" data-testid="shop-extra-new-name"/>
                </div>
                <label class="native-select shop-add-store">
                    <span>Store</span>
                    <select @bind="_extraStore" data-testid="shop-extra-new-store">
                        <option value="">Anywhere</option>
                        @foreach (Store store in _stores)
                        {
                            <option value="@store.Id">@store.Name</option>
                        }
                    </select>
                </label>
                <div class="shop-add-price">
                    <MudTextField T="string" @bind-Value="_extraPrice" Label="Price (if known)" Variant="Variant.Outlined"
                                  Immediate="true" InputMode="@(InputMode.@decimal)" InputId="shop-extra-new-price" data-testid="shop-extra-new-price"/>
                </div>
                <div class="shop-add-go">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="shop-add-button"
                               data-testid="shop-extra-add">Add</MudButton>
                </div>
            </form>
            @if (_extraError is not null)
            {
                <p class="shop-error" role="alert" data-testid="shop-extra-error">@_extraError</p>
            }
        </section>

        @if (_book.InPantry.Count > 0)
        {
            <PadSheet Title="In the pantry" Subtitle="Enough at home for these days, if the pantry is right. Tick to say you checked." Class="shop-sheet">
                @foreach (ShoppingLine line in _book.InPantry)
                {
                    bool have = line.Tick != ShoppingTick.None;
                    <div class="@($"shop-line shop-tap{(_unsent.Contains(line.ItemId) ? " unsent" : "")}")" @key="line.ItemId" role="checkbox" tabindex="0"
                         aria-checked="@(have ? "true" : "false")" aria-label="@($"{line.Ingredient.Name}: checked")"
                         @onclick="() => Tick(line, have ? ShoppingTick.None : ShoppingTick.HaveIt)"
                         data-testid="shop-pantry-line" data-id="@line.Ingredient.Id" data-tick="@line.Tick">
                        <span class="shop-box-col">
                            <span class="@($"shop-box{(have ? " have" : "")}")">
                                @if (have)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small"/>
                                }
                            </span>
                        </span>
                        <span class="@($"shop-what{(have ? " struck" : "")}")">
                            <span class="shop-name">@line.Ingredient.Name</span>
                            <span class="shop-detail" data-testid="shop-pantry-detail">@ShoppingText.Detail(line)</span>
                        </span>
                    </div>
                }
            </PadSheet>
        }

        @if (_lists.Count > 0)
        {
            <PadSheet Title="Other lists" Class="shop-sheet shop-others">
                @foreach (ShoppingList list in _lists)
                {
                    <a class="shop-list-link" href="@Link(list.StartsOn, list.EndsOn)" data-testid="shop-list-link" data-id="@list.Id">
                        <span>@ShoppingText.Range(list.StartsOn, list.EndsOn)</span>
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight"/>
                    </a>
                }
            </PadSheet>
        }
    }
</div>
</LocalDataGate>

@code {
    /// <summary>"2026-10-26": the list's first day, so a link or a reload keeps it.</summary>
    [SupplyParameterFromQuery(Name = "from")] public string? FromParameter { get; set; }

    [SupplyParameterFromQuery(Name = "to")] public string? ToParameter { get; set; }

    private ShoppingBook?      _book;
    private List<Store>        _stores = [];
    private List<ShoppingList> _lists  = [];

    /// <summary>Ticks and extras still in the outbox: their rows wear the dashed edge of an edit not on the server yet.</summary>
    private HashSet<Guid> _unsent = [];

    private DateOnly _from;
    private DateOnly _to;
    private bool     _chosen;

    private bool      _editingRange;
    private DateOnly? _newFrom;
    private DateOnly? _newTo;
    private string?   _rangeError;

    private string? _extraName;
    private string? _extraStore;
    private string? _extraPrice;
    private string? _extraError;

    /// <summary>Set while a tap's ops are written: a second tap on a line in that moment would undo the first from stale state.</summary>
    private bool _busy;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private static string Link(DateOnly from, DateOnly to) => $"shopping?from={OpValues.FormatDate(from)}&to={OpValues.FormatDate(to)}";

    protected override async Task OnParametersSetAsync()
    {
        if (OpValues.TryParseDate(FromParameter, out DateOnly from) && OpValues.TryParseDate(ToParameter, out DateOnly to)
            && ShoppingListRules.RangeProblem(from, to) is null)
        {
            bool changed = !_chosen || from != _from || to != _to;
            (_from, _to, _chosen) = (from, to, true);
            if (changed && Ready)
                await Reload();
        }
        else if (_chosen && Ready)
        {
            // Back to /shopping with no days: choose again.
            _chosen = false;
            await Reload();
        }
    }

    protected override async Task LoadAsync(LocalDbContext db)
    {
        List<ShoppingList> lists = await db.ShoppingLists.AsNoTracking().Where(l => !l.Deleted).ToListAsync();
        if (!_chosen)
        {
            // The list covering today, the latest started; otherwise this calendar week, Monday to Sunday - the list the
            // calendar's "Shopping list" opens. The list's id is its dates, so any other default (today + 6) would put two
            // phones' ticks on two lists that never meet.
            (_from, _to) = lists.Where(l => l.StartsOn <= Today && l.EndsOn >= Today).OrderByDescending(l => l.StartsOn).FirstOrDefault() is { } current
                ? (current.StartsOn, current.EndsOn)
                : (Rotation.MondayOf(Today), Rotation.MondayOf(Today).AddDays(6));
            _chosen = true;
        }
        _book   = await ShoppingBook.LoadAsync(db, _from, _to);
        _stores = [.. (await db.Stores.AsNoTracking().Where(s => !s.Deleted).ToListAsync()).OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase)];
        _lists  = [.. lists.Where(l => l.Id != _book.ListId && l.EndsOn >= Today.AddDays(-28)).OrderByDescending(l => l.StartsOn).Take(8)];
        _unsent = [.. await db.Outbox.AsNoTracking().Select(o => o.EntityId).ToListAsync()];
        (_newFrom, _newTo) = (_from, _to);
    }

    /// <summary>What is left to get and what is done: every line ticked either way, and the extras bought.</summary>
    private (int Left, int Done) Counts()
    {
        List<ShoppingLine> lines = [.. _book!.Groups.SelectMany(g => g.Categories).SelectMany(c => c.Lines)];
        int extras = _book.Extras.Count;
        int done = lines.Count(l => l.Tick != ShoppingTick.None) + _book.Extras.Count(e => e.Tick == ShoppingTick.Bought);
        return (lines.Count + extras - done, done);
    }

    private void ShowRange()
    {
        if (_newFrom is not { } from || _newTo is not { } to)
        {
            _rangeError = "Pick both days.";
            return;
        }
        if (ShoppingListRules.RangeProblem(from, to) is { } problem)
        {
            _rangeError = problem;
            return;
        }
        _rangeError   = null;
        _editingRange = false;
        Navigation.NavigateTo(Link(from, to));
    }

    private async Task Tick(ShoppingLine line, ShoppingTick to)
    {
        if (_busy || _book is null)
            return;
        _busy = true;
        try
        {
            List<ShoppingEdit> edits;
            await using (LocalDbContext db = await Database.Contexts.CreateDbContextAsync())
                edits = await ShoppingTicking.EditsAsync(db, _book, line, to, Today, Guid.CreateVersion7);
            await WriteAllAsync([.. edits.Select(e => new LocalEdit(e.Type, e.Id, e.Kind, e.Fields))]);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TickExtra(ShoppingListItem extra)
    {
        if (_busy)
            return;
        _busy = true;
        try
        {
            ShoppingTick to = extra.Tick == ShoppingTick.Bought ? ShoppingTick.None : ShoppingTick.Bought;
            await WriteAsync(SyncedEntities.ShoppingListItem, extra.Id, OpKind.Update, [new OpField(ShoppingItemRules.TickField, ShoppingTicks.Format(to))]);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddExtra()
    {
        long? price = null;
        if (!string.IsNullOrWhiteSpace(_extraPrice))
        {
            price = Money.ParseCents(_extraPrice, out string? priceProblem);
            if (priceProblem is not null)
            {
                _extraError = priceProblem;
                return;
            }
        }
        Guid? store = Guid.TryParse(_extraStore, out Guid s) ? s : null;
        ExtraItemDraft draft = new(_extraName ?? "", store, price);
        if (draft.Problem() is { } problem)
        {
            _extraError = problem;
            return;
        }

        List<ShoppingEdit> list;
        await using (LocalDbContext db = await Database.Contexts.CreateDbContextAsync())
            list = await ShoppingTicking.ListAsync(db, _from, _to);
        await WriteAllAsync([
            .. list.Select(e => new LocalEdit(e.Type, e.Id, e.Kind, e.Fields)),
            new LocalEdit(SyncedEntities.ShoppingListItem, Guid.CreateVersion7(), OpKind.Create, draft.FieldsChangedFrom(_book!.ListId, null)),
        ]);
        (_extraName, _extraPrice, _extraError) = (null, null, null);
    }

    private Task RemoveExtra(ShoppingListItem extra) => WriteAsync(SyncedEntities.ShoppingListItem, extra.Id, OpKind.Delete, []);
}
