@page "/stores"
@using AshersLab.MealPlanner.LocalData
@using AshersLab.MealPlanner.Shared.Data.Stores
@using AshersLab.MealPlanner.Shared.Data.Sync
@using AshersLab.MealPlanner.Shared.Domain.Stores
@using AshersLab.MealPlanner.Shared.Domain.Sync
@using AshersLab.MealPlanner.WASM.Data
@using Microsoft.EntityFrameworkCore
@inherits LocalDataPage

@*
    Where groceries come from. Woolworths and Costco are there from the start (the server seeds them); the
    household adds the butcher or the market. A store an ingredient uses as its usual store, or that sells a product,
    cannot be deleted.
*@

<PageTitle>Stores - Meal Planner</PageTitle>

<div class="pad-column">
<LocalDataGate Start="Start" Title="@SheetTitle" Subtitle="@SheetSubtitle">
    <NameList Title="@SheetTitle" Subtitle="@SheetSubtitle" Unsent="_unsent"
              Items="_stores" Noun="store" TestId="store" NewLabel="New store"
              NameProblem="StoreRules.NameProblem"
              InUseHint="Give the ingredients another usual store, and delete the products, first."
              OnAdd="Add" OnRename="Rename" OnDelete="Delete"/>
</LocalDataGate>
</div>

@code {
    // The sheet's head, which LocalDataGate also shows while the page loads.
    private const string SheetTitle    = "Stores";
    private const string SheetSubtitle = "Where you shop: prices and the shopping list are split by store.";

    private List<NameListItem> _stores = [];
    private HashSet<Guid>      _unsent = [];

    protected override async Task LoadAsync(LocalDbContext db)
    {
        _unsent = [.. await db.Outbox.AsNoTracking().Select(o => o.EntityId).ToListAsync()];
        List<Store> stores = await db.Stores.AsNoTracking().Where(s => !s.Deleted).ToListAsync();
        ILookup<Guid?, string> usedBy = (await db.Ingredients.AsNoTracking()
                .Where(i => !i.Deleted && i.UsualStoreId != null)
                .Select(i => new { i.UsualStoreId, i.Name })
                .ToListAsync())
            .OrderBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToLookup(i => i.UsualStoreId, i => i.Name);
        ILookup<Guid, string> sells = (await db.Products.AsNoTracking()
                .Where(p => !p.Deleted)
                .Select(p => new { p.StoreId, p.Name })
                .ToListAsync())
            .OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToLookup(p => p.StoreId, p => p.Name);

        _stores = [.. stores
            .OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase)
            .Select(s => new NameListItem(s.Id, s.Name, [.. usedBy[s.Id]], [.. sells[s.Id]]))];
    }

    private Task Add(string name) =>
        WriteAsync(SyncedEntities.Store, Guid.CreateVersion7(), OpKind.Create, [new OpField(StoreRules.NameField, name)]);

    private Task Rename(Guid id, string name) =>
        WriteAsync(SyncedEntities.Store, id, OpKind.Update, [new OpField(StoreRules.NameField, name)]);

    private Task Delete(Guid id) => WriteAsync(SyncedEntities.Store, id, OpKind.Delete, []);
}
