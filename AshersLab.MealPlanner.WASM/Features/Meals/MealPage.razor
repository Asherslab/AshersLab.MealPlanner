@page "/meals/{Id:guid}"
@using AshersLab.MealPlanner.LocalData
@using AshersLab.MealPlanner.Shared.Data.Categories
@using AshersLab.MealPlanner.Shared.Data.Ingredients
@using AshersLab.MealPlanner.Shared.Data.Stores
@using AshersLab.MealPlanner.Shared.Data.Meals
@using AshersLab.MealPlanner.Shared.Data.Planning
@using AshersLab.MealPlanner.Shared.Data.Sync
@using AshersLab.MealPlanner.Shared.Domain.Ingredients
@using AshersLab.MealPlanner.Shared.Domain.Meals
@using AshersLab.MealPlanner.Shared.Domain.Prices
@using AshersLab.MealPlanner.Shared.Domain.Sync
@using AshersLab.MealPlanner.WASM.Data
@using AshersLab.MealPlanner.WASM.Features.Ingredients
@using AshersLab.MealPlanner.WASM.Features.Planning
@using AshersLab.MealPlanner.WASM.Features.Products
@using Microsoft.EntityFrameworkCore
@inherits LocalDataPage
@inject IDialogService Dialogs
@inject IBrowserViewportService Viewport
@inject NavigationManager Navigation

@*
    One meal, as one pad sheet: its name in marker on the head band, what it costs as ruled rows, then - for a meal
    made from ingredients - its ingredients, each with what it adds to the batch, and an unpriced one said plainly. Edit opens the editor for the meal's own fields (and delete); tapping an ingredient opens its
    sheet; "Add ingredient" adds one. A page rather than a dialog because each ingredient is edited on its own, and
    each is its own op.
*@

<PageTitle>@(_meal?.Name ?? "Meal") - Meal Planner</PageTitle>

<div class="meal">
    @* On a phone the app bar's back arrow goes to Meals; this is the wide screen's way back. *@
    <div class="meal-back">
        <MudButton Href="meals" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack"
                   data-testid="meal-back">Meals</MudButton>
    </div>

    @* Until the meal is read: its band, the name and summary lines held blank, so the band does not move when they land. *@
    <LocalDataGate Start="Start">
        <Head>
            <h1 class="marker meal-title">&nbsp;</h1>
            <p class="meal-summary">&nbsp;</p>
            <div class="meal-edit">
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
            </div>
        </Head>
        <ChildContent>
        @if (_meal is null)
        {
            <PadSheet Title="Meal not found">
                <p class="pad-note" data-testid="meal-gone">
                    This meal is not here - it may have been deleted on another device. Back to <a href="meals">Meals</a>.
                </p>
            </PadSheet>
        }
        else
        {
            MealCost cost = _costs.CostOf(_meal);
            IReadOnlyList<MealIngredient> lines = _costs.LinesOf(_meal.Id);

            <PadSheet TestId="meal-sheet">
                <Head>
                    <h1 class="marker meal-title" data-testid="meal-title">@_meal.Name</h1>
                    <p class="meal-summary" data-testid="meal-summary">@Summary()</p>
                    <div class="meal-edit">
                        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="Edit" data-testid="meal-edit">Edit</MudButton>
                    </div>
                </Head>
                <ChildContent>
                    <div data-testid="meal-cost">
                        @switch (_meal.Kind)
                        {
                            case MealKind.Leftovers:
                                <PadRow Label="Cost">
                                    <p class="meal-cost-note" data-testid="meal-cost-note">Eats a serve of a batch cooked earlier - that batch is what it costs.</p>
                                </PadRow>
                                break;
                            case MealKind.NoCost:
                                <PadRow Label="Cost">
                                    <p class="meal-cost-note" data-testid="meal-cost-note">Costs nothing.</p>
                                </PadRow>
                                break;
                            case MealKind.Simple when cost.PerServe is { } serve:
                                <PadRow Label="A serve">
                                    <span class="meal-cost-figure" data-testid="meal-cost-serve">@serve.Format()</span>
                                </PadRow>
                                break;
                            case not MealKind.Simple when cost.Batch is { } batch && cost.PerServe is { } serve:
                                <PadRow Label="@(_meal.Kind == MealKind.FixedCost ? "All up" : "A batch")">
                                    <span class="meal-cost-figure" data-testid="meal-cost-batch">@batch.Format()</span>
                                </PadRow>
                                <PadRow Label="A serve">
                                    <span class="meal-cost-figure" data-testid="meal-cost-serve">@serve.Format()</span>
                                    <div class="pad-entry-meta">one of @MealText.Serves(_meal.ServesPerBatch)</div>
                                </PadRow>
                                break;
                            default:
                                <PadRow Label="Cost">
                                    <p class="meal-cost-note" data-testid="meal-cost-note">No ingredients yet - add them below to see what it costs.</p>
                                </PadRow>
                                break;
                        }
                    </div>

                    @if (_meal.Notes is { } notes)
                    {
                        <PadRow Label="Notes">
                            <p class="meal-notes-text" data-testid="meal-notes">@notes</p>
                        </PadRow>
                    }

                    @if (_meal.Kind.HasIngredients())
                    {
                        <div class="meal-lines-head">
                            <h2>@(_meal.Kind == MealKind.Simple ? "Ingredients, for one serve" : "Ingredients, for a batch")</h2>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                       Class="meal-add-line" OnClick="AddLine" data-testid="meal-ingredient-add">Add ingredient</MudButton>
                        </div>
                        @if (lines.Count == 0)
                        {
                            <p class="pad-note meal-lines-empty" data-testid="meal-ingredients-empty">
                                No ingredients yet. Add each one with how much a batch uses, and the cost adds up above.
                            </p>
                        }
                        @for (int i = 0; i < lines.Count; i++)
                        {
                            MealIngredient line = lines[i];
                            LineCost lineCost = cost.Lines[i];
                            Ingredient? ingredient = _costs.Ingredient(line.IngredientId);
                            <div class="@(_unsent.Contains(line.Id) ? "meal-line unsent" : "meal-line")" @key="line.Id" role="button" tabindex="0"
                                 @onclick="() => EditLine(line)" @onkeydown="e => OnLineKey(e, line)"
                                 data-testid="meal-ingredient-row" data-id="@line.Id">
                                <div class="meal-line-text">
                                    <span class="meal-line-name" data-testid="meal-ingredient-name">@(ingredient?.Name ?? "ingredient removed")</span>
                                    <span class="meal-line-detail" data-testid="meal-ingredient-detail">@LineDetail(line, ingredient)</span>
                                </div>
                                <span class="@(lineCost.State == LineState.Costed ? "meal-line-cost" : "meal-line-cost incomplete")"
                                      data-testid="meal-ingredient-cost">@LineCostText(lineCost)</span>
                            </div>
                        }
                    }
                    else if (lines.Count > 0)
                    {
                        <p class="pad-note meal-lines-kept" data-testid="meal-ingredients-kept">
                            @lines.Count ingredient@(lines.Count == 1 ? " is" : "s are") kept from before, and not used while it is @_meal.Kind.Label().ToLowerInvariant().
                        </p>
                    }
                </ChildContent>
            </PadSheet>
        }
        </ChildContent>
    </LocalDataGate>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private Meal?           _meal;
    private List<MealGroup> _groups     = [];
    private List<string>    _otherNames = [];
    private MealCostBook    _costs      = null!;
    private PlanBook        _plans      = null!;
    private List<CalendarEntry> _coming = [];
    private List<Category>  _categories = [];
    private List<Store>     _stores     = [];
    private HashSet<Guid>   _unsent     = [];

    // The same page instance shows another meal when only the id in the address changes.
    protected override async Task OnParametersSetAsync()
    {
        if (Ready)
            await Reload();
    }

    protected override async Task LoadAsync(LocalDbContext db)
    {
        _meal       = await db.Meals.AsNoTracking().SingleOrDefaultAsync(m => m.Id == Id && !m.Deleted);
        _groups     = [.. MealGroupEntity.InOrder(await db.MealGroups.AsNoTracking().Where(g => !g.Deleted).ToListAsync())];
        _otherNames = await db.Meals.AsNoTracking().Where(m => !m.Deleted && m.Id != Id).Select(m => m.Name).ToListAsync();
        _costs      = await MealCostBook.LoadAsync(db);
        _plans      = await PlanBook.LoadAsync(db);
        _coming     = await CalendarBook.ComingAsync(db, DateOnly.FromDateTime(DateTime.Now));
        _categories = [.. CategoryEntity.InOrder(await db.Categories.AsNoTracking().Where(c => !c.Deleted).ToListAsync())];
        _stores     = [.. (await db.Stores.AsNoTracking().Where(s => !s.Deleted).ToListAsync())
            .OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase)];
        _unsent     = [.. await db.Outbox.AsNoTracking().Select(o => o.EntityId).ToListAsync()];
    }

    /// <summary>A line is a button to the keyboard too: Enter or Space opens it.</summary>
    private async Task OnLineKey(KeyboardEventArgs e, MealIngredient line)
    {
        if (e.Key is "Enter" or " ")
            await EditLine(line);
    }

    /// <summary>The plans that use the meal, and the calendar when a coming entry names it.</summary>
    private List<string> UsedBy() =>
    [
        .. _plans.PlansWithMeal(Id),
        .. CalendarText.Use(_coming, DateOnly.FromDateTime(DateTime.Now), e => e.MealId == Id) is { } calendar ? [calendar] : Array.Empty<string>(),
    ];

    /// <summary>"Beef · makes 4 serves".</summary>
    private string Summary() =>
        string.Join(" · ", new[]
        {
            _meal!.GroupId is { } group ? _groups.FirstOrDefault(g => g.Id == group)?.Name ?? "group removed" : "No group",
            MealText.Detail(_meal),
        });

    /// <summary>"500 g · grated", "no quantity yet", "1.5 kg · $16.66/kg at Costco".</summary>
    private string LineDetail(MealIngredient line, Ingredient? ingredient) =>
        string.Join(" · ", new[]
        {
            line.Quantity is { } quantity && ingredient is not null ? Quantity.Format(quantity, ingredient.BaseUnit)
                : line.Quantity is null ? "no quantity yet" : null,
            line.Note,
            ingredient is not null && _costs.PriceOf(ingredient.Id) is { } price ? price.UnitPrice.Format(ingredient.BaseUnit) : null,
        }.Where(s => s is not null));

    private static string LineCostText(LineCost line) => line.State switch
    {
        LineState.Costed     => Money.Format(line.Cents!.Value),
        LineState.NoQuantity => "how much?",
        _                    => "unpriced",
    };

    private List<IngredientOption> IngredientOptions() =>
        [.. _costs.Ingredients.OrderBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase).Select(i => new IngredientOption(i.Id, i.Name, i.BaseUnit))];

    private async Task AddLine()
    {
        MealIngredientDraft line = new(Id, Guid.Empty, null, null);
        while (true)
        {
            MealIngredientSheetResult? result = await MealDialogs.EditLineAsync(Dialogs, Viewport, line, isNew: true, IngredientOptions());
            if (result?.Saved is { } draft)
            {
                await WriteAsync(SyncedEntities.MealIngredient, Guid.CreateVersion7(), OpKind.Create, draft.FieldsChangedFrom(null));
                return;
            }
            if (result?.NewIngredient is not { } name)
                return;

            // The ingredient editor, as on the Ingredients page; saved, the sheet opens again with it chosen and the
            // amount box focused. Cancelled, back to the search.
            IngredientEditorResult? made = await IngredientDialogs.EditAsync(Dialogs, Viewport,
                new IngredientDraft(name, null, null, null, false), isNew: true,
                [.. _categories.Select(c => new PickerOption(c.Id, c.Name))],
                [.. _stores.Select(s => new PickerOption(s.Id, s.Name))],
                [.. _costs.Ingredients.Select(i => i.Name)]);
            if (made?.Saved is { } ingredient)
            {
                Guid ingredientId = Guid.CreateVersion7();
                await WriteAsync(SyncedEntities.Ingredient, ingredientId, OpKind.Create, ingredient.FieldsChangedFrom(null));
                line = line with { IngredientId = ingredientId };
            }
        }
    }

    private async Task EditLine(MealIngredient line)
    {
        MealIngredientDraft before = line.Draft();
        MealIngredientSheetResult? result = await MealDialogs.EditLineAsync(Dialogs, Viewport, before, isNew: false, IngredientOptions());

        if (result is { Remove: true })
            await WriteAsync(SyncedEntities.MealIngredient, line.Id, OpKind.Delete, []);
        else if (result?.Saved is { } draft && draft.FieldsChangedFrom(before) is { Count: > 0 } fields)
            await WriteAsync(SyncedEntities.MealIngredient, line.Id, OpKind.Update, fields);
    }

    private async Task Edit()
    {
        MealDraft before = _meal!.Draft();
        MealEditorResult? result = await MealDialogs.EditAsync(Dialogs, Viewport, before, isNew: false,
            [.. _groups.Select(g => new PickerOption(g.Id, g.Name))], _otherNames, UsedBy());

        if (result is { Delete: true })
        {
            // Its lines go too, one op each, so no table keeps rows of a meal nobody can see: nothing cascades on
            // sync. A line added on another device meanwhile is left behind, shown nowhere and costing nothing.
            IReadOnlyList<MealIngredient> lines = _costs.LinesOf(Id);
            await WriteAsync(SyncedEntities.Meal, Id, OpKind.Delete, []);
            foreach (MealIngredient line in lines)
                await WriteAsync(SyncedEntities.MealIngredient, line.Id, OpKind.Delete, []);
            Navigation.NavigateTo("meals");
        }
        else if (result?.Saved is { } draft && draft.FieldsChangedFrom(before) is { Count: > 0 } fields)
            await WriteAsync(SyncedEntities.Meal, Id, OpKind.Update, fields);
    }
}
