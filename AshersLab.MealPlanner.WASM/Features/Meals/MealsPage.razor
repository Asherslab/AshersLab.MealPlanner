@page "/meals"
@using AshersLab.MealPlanner.LocalData
@using AshersLab.MealPlanner.Shared.Data.Meals
@using AshersLab.MealPlanner.Shared.Data.Sync
@using AshersLab.MealPlanner.Shared.Domain
@using AshersLab.MealPlanner.Shared.Domain.Meals
@using AshersLab.MealPlanner.Shared.Domain.Sync
@using AshersLab.MealPlanner.WASM.Data
@using AshersLab.MealPlanner.WASM.Features.Ingredients
@using Microsoft.EntityFrameworkCore
@inherits LocalDataPage
@inject IDialogService Dialogs
@inject IBrowserViewportService Viewport
@inject NavigationManager Navigation

@*
    The household's recipe box: one pad sheet of every meal, under its group in the household's order. The box at
    the top of the sheet both searches and starts a new one - type a name and tap Add (or Enter) to open the editor
    with it filled in; saving opens the new meal's page, where its ingredients go. Each meal is written in marker, with
    what it makes and what a serve costs (MealCosting) under it, or "from $X a serve + N unpriced" while an ingredient
    has no quantity or price. A meal not yet on the server has a dashed edge.

    Each group's rows sit in a "mud-paper" block straight after the group's heading: the check scripts find a meal's
    group as the heading before its block (.claude/tools, `closest('.mud-paper').previousElementSibling`).
*@

<PageTitle>Meals - Meal Planner</PageTitle>

<div class="meals">
    <LocalDataGate Start="Start" Title="Meals">
        <PadSheet Title="Meals" Subtitle="@CountText()" TestId="meals-sheet">
            <form class="meals-find" @onsubmit="Add" @onsubmit:preventDefault>
                <MudTextField T="string" @bind-Value="_newName" Label="New meal, or search" Variant="Variant.Outlined"
                              Immediate="true" MaxLength="Names.MaxLength"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              InputId="meal-new-name" data-testid="meal-new-name"/>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" Class="meals-add" data-testid="meal-add">Add</MudButton>
            </form>

            @if (_meals.Count == 0)
            {
                <p class="pad-note" data-testid="meals-empty">
                    No meals yet. Type the first one's name above and tap Add.
                </p>
            }
            else if (!Groups().Any())
            {
                <p class="pad-note" data-testid="meals-none-match">
                    No meal is called "@Names.Normalise(_newName)". Tap Add to make it.
                </p>
            }

            @foreach ((string heading, List<Meal> items) in Groups())
            {
                <h3 class="meals-group" data-testid="meal-list-group">@heading</h3>
                <div class="mud-paper meals-rows">
                    @foreach (Meal meal in items)
                    {
                        <a class="@(_unsent.Contains(meal.Id) ? "meals-row unsent" : "meals-row")" @key="meal.Id"
                           href="@($"meals/{meal.Id}")" data-testid="meal-row" data-id="@meal.Id">
                            <span class="meals-row-text">
                                <span class="marker" data-testid="meal-name">@meal.Name</span>
                                <span class="meals-row-detail" data-testid="meal-detail">@MealText.Detail(meal, _costs.CostOf(meal))</span>
                            </span>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="meals-row-go" aria-hidden="true"/>
                        </a>
                    }
                </div>
            }
        </PadSheet>

        <p class="pad-aside">
            Groups and their order are on <a href="meal-groups">Meal groups</a>; ingredients are on
            <a href="ingredients">Ingredients</a>.
        </p>
    </LocalDataGate>
</div>

@code {
    private List<Meal>      _meals  = [];
    private List<MealGroup> _groups = [];
    private MealCostBook    _costs  = null!;
    private HashSet<Guid>   _unsent = [];

    private string? _newName;

    protected override async Task LoadAsync(LocalDbContext db)
    {
        _meals  = await db.Meals.AsNoTracking().Where(m => !m.Deleted).ToListAsync();
        _groups = [.. MealGroupEntity.InOrder(await db.MealGroups.AsNoTracking().Where(g => !g.Deleted).ToListAsync())];
        _costs  = await MealCostBook.LoadAsync(db);
        _unsent = [.. await db.Outbox.AsNoTracking().Select(o => o.EntityId).ToListAsync()];
    }

    private string CountText() => _meals.Count switch
    {
        0 => "Your recipe box",
        1 => "1 meal, by group",
        _ => $"{_meals.Count} meals, by group",
    };

    /// <summary>The meals matching the box, under their group in group order; "No group" (none, or one deleted) last.</summary>
    private IEnumerable<(string Heading, List<Meal> Items)> Groups()
    {
        string filter = Names.Normalise(_newName);
        List<Meal> shown = [.. _meals
            .Where(m => filter.Length == 0 || m.Name.Contains(filter, StringComparison.CurrentCultureIgnoreCase))
            .OrderBy(m => m.Name, StringComparer.CurrentCultureIgnoreCase)];

        HashSet<Guid> live = [.. _groups.Select(g => g.Id)];
        foreach (MealGroup group in _groups)
        {
            List<Meal> items = [.. shown.Where(m => m.GroupId == group.Id)];
            if (items.Count > 0)
                yield return (group.Name, items);
        }

        List<Meal> loose = [.. shown.Where(m => m.GroupId is not { } id || !live.Contains(id))];
        if (loose.Count > 0)
            yield return ("No group", loose);
    }

    private async Task Add()
    {
        MealEditorResult? result = await MealDialogs.EditAsync(Dialogs, Viewport,
            new MealDraft(Names.Normalise(_newName), null, MealKind.Cooked, 1, null, null), isNew: true,
            [.. _groups.Select(g => new PickerOption(g.Id, g.Name))], [.. _meals.Select(m => m.Name)]);
        if (result?.Saved is not { } draft)
            return;

        _newName = null;
        Guid id = Guid.CreateVersion7();
        await WriteAsync(SyncedEntities.Meal, id, OpKind.Create, draft.FieldsChangedFrom(null));
        Navigation.NavigateTo($"meals/{id}");
    }
}
