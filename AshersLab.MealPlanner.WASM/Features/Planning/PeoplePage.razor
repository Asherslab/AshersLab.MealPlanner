@page "/people"
@using AshersLab.MealPlanner.LocalData
@using AshersLab.MealPlanner.Shared.Data.Planning
@using AshersLab.MealPlanner.Shared.Data.Sync
@using AshersLab.MealPlanner.Shared.Domain
@using AshersLab.MealPlanner.Shared.Domain.Planning
@using AshersLab.MealPlanner.Shared.Domain.Sync
@using AshersLab.MealPlanner.WASM.Data
@using Microsoft.EntityFrameworkCore
@inherits LocalDataPage
@inject IDialogService Dialogs

@*
    The household: a name, a colour and a portion each - how much of a serve they eat, a toddler's half. Nobody is seeded - names are personal and the code is public - so the
    planner adds everyone here. A plan entry is for everyone unless it names some of them. Someone a plan names cannot
    be deleted.

    One pad sheet: a line to add someone at the top, then a ruled row per person - their magnet, their name - the
    whole row a tap to open it for the name, the colour (the magnets themselves to pick from) and delete.
*@

<PageTitle>People - Meal Planner</PageTitle>

<div class="people">
    <LocalDataGate Start="Start" Title="@SheetTitle" Subtitle="@SheetSubtitle">
        <PadSheet Title="@SheetTitle" Subtitle="@SheetSubtitle">
            <form class="person-add" @onsubmit="Add" @onsubmit:preventDefault>
                <MudTextField T="string" @bind-Value="_newName" Label="New person" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" MaxLength="Names.MaxLength" Class="person-field"
                              Error="_addError is not null" ErrorText="@_addError"
                              InputId="person-new-name" data-testid="person-new-name"/>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="person-add-button"
                           StartIcon="@Icons.Material.Filled.Add" data-testid="person-add">Add</MudButton>
            </form>

            @if (_people.Count == 0)
            {
                <p class="pad-note" data-testid="person-empty">Nobody yet - write each person in the household in the box above.</p>
            }
            @foreach (Person person in _people)
            {
                <div class="@($"person-row{(_unsent.Contains(person.Id) ? " unsent" : "")}{(_editing == person.Id ? " editing" : "")}")"
                     @key="person.Id" data-testid="person-row" data-id="@person.Id">
                    @if (_editing == person.Id)
                    {
                        <form class="person-edit" @onsubmit="() => Save(person)" @onsubmit:preventDefault>
                            <MudTextField T="string" @bind-Value="_editName" Label="Name" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Immediate="true" AutoFocus="true" MaxLength="Names.MaxLength"
                                          Error="_editError is not null" ErrorText="@_editError"
                                          InputId="person-edit-name" data-testid="person-edit-name"/>
                            <span class="person-colour-label" id="@($"person-colour-{person.Id}")">Their magnet</span>
                            <div class="person-colours" role="radiogroup" aria-labelledby="@($"person-colour-{person.Id}")">
                                @foreach (string colour in PersonRules.Palette)
                                {
                                    <button type="button" class="@($"colour-swatch{(colour == _editColour ? " chosen" : "")}")"
                                            style="@($"background:{colour}")" aria-label="@colour" aria-checked="@(colour == _editColour)"
                                            role="radio" @onclick="() => _editColour = colour" data-testid="person-colour" data-colour="@colour"></button>
                                }
                            </div>
                            @* A native select: one thumb, the phone's own picker. *@
                            <label class="native-select person-portion">
                                <span>Eats</span>
                                <select value="@OpValues.FormatDecimal(_editPortion)" data-testid="person-portion"
                                        @onchange="e => _editPortion = OpValues.TryParseDecimal(e.Value?.ToString(), out decimal p) ? p : _editPortion">
                                    @foreach (decimal portion in PersonRules.Portions)
                                    {
                                        <option value="@OpValues.FormatDecimal(portion)">@PersonRules.PortionText(portion)</option>
                                    }
                                </select>
                            </label>
                            <p class="person-portion-help">What a meal's serves count them as: a toddler on half a serve leaves more of the batch.</p>
                            @if (_inUse.Count > 0)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3" data-testid="person-in-use">
                                    @person.Name is named in @string.Join(", ", _inUse). Make those entries for everyone, or someone else, first.
                                </MudAlert>
                            }
                            <div class="person-edit-actions">
                                <MudButton Color="Color.Error" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.DeleteOutline"
                                           OnClick="() => Delete(person)" Class="mr-auto" data-testid="person-delete">Delete</MudButton>
                                <MudButton Variant="Variant.Text" OnClick="() => _editing = null" data-testid="person-cancel">Cancel</MudButton>
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" data-testid="person-save">Save</MudButton>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="person-line" role="button" tabindex="0" aria-label="@($"Edit {person.Name}")"
                             @onclick="() => StartEdit(person)"
                             @onkeydown="e => RowKey(e, person)">
                            <span class="magnet person-magnet" style="@($"background:{person.Colour}")"></span>
                            <span class="person-name" data-testid="person-name">@person.Name</span>
                            @if (person.Portion is { } portion && portion != 1)
                            {
                                <span class="person-portion-note" data-testid="person-portion-note">eats @PersonRules.PortionText(portion)</span>
                            }
                            @if (_unsent.Contains(person.Id))
                            {
                                <span class="person-unsent">Not sent yet</span>
                            }
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="person-chevron"/>
                        </div>
                    }
                </div>
            }
        </PadSheet>
    </LocalDataGate>
</div>

@code {
    // The sheet's head, which LocalDataGate also shows while the page loads.
    private const string SheetTitle    = "People";
    private const string SheetSubtitle = "Everyone who eats from the plan. An entry is for everyone unless it says who.";

    private List<Person> _people = [];
    private PlanBook     _plans  = null!;
    private List<CalendarEntry> _coming = [];
    private HashSet<Guid> _unsent = [];

    private string? _newName;
    private string? _addError;

    private Guid?        _editing;
    private string?      _editName;
    private string       _editColour = "";
    private decimal      _editPortion = 1;
    private string?      _editError;
    private List<string> _inUse = [];

    protected override async Task LoadAsync(LocalDbContext db)
    {
        _people = [.. Person.InOrder(await db.People.AsNoTracking().Where(p => !p.Deleted).ToListAsync())];
        _plans  = await PlanBook.LoadAsync(db);
        _coming = await CalendarBook.ComingAsync(db, DateOnly.FromDateTime(DateTime.Now));
        _unsent = [.. await db.Outbox.AsNoTracking().Select(o => o.EntityId).ToListAsync()];
    }

    private string? Problem(string name, Guid? id) =>
        PersonRules.NameProblem(name)
        ?? (_people.Any(p => p.Id != id && Names.Same(p.Name, name)) ? $"There is already someone called {name}." : null);

    private async Task Add()
    {
        string name = Names.Normalise(_newName);
        _addError = Problem(name, null);
        if (_addError is not null)
            return;

        _newName = null;
        await WriteAsync(SyncedEntities.Person, Guid.CreateVersion7(), OpKind.Create,
        [
            new OpField(PersonRules.NameField, name),
            new OpField(PersonRules.ColourField, PersonRules.NextColour(_people.Select(p => p.Colour))),
        ]);
    }

    private void StartEdit(Person person)
    {
        _editing    = person.Id;
        _editName   = person.Name;
        _editColour = person.Colour;
        _editPortion = person.Portion ?? 1;
        _editError  = null;
        _inUse      = [];
    }

    /// <summary>The row is a button to the keyboard too: Enter or Space opens it.</summary>
    private void RowKey(KeyboardEventArgs e, Person person)
    {
        if (e.Key is "Enter" or " ")
            StartEdit(person);
    }

    private async Task Save(Person person)
    {
        string name = Names.Normalise(_editName);
        _editError = Problem(name, person.Id);
        if (_editError is not null)
            return;

        // Only what changed: an op that changes nothing would still win against an edit made elsewhere.
        List<OpField> fields = [];
        if (name != person.Name)
            fields.Add(new OpField(PersonRules.NameField, name));
        if (_editColour != person.Colour)
            fields.Add(new OpField(PersonRules.ColourField, _editColour));
        if (_editPortion != (person.Portion ?? 1))
            fields.Add(new OpField(PersonRules.PortionField, OpValues.FormatDecimal(_editPortion)));
        _editing = null;
        if (fields.Count > 0)
            await WriteAsync(SyncedEntities.Person, person.Id, OpKind.Update, fields);
    }

    private async Task Delete(Person person)
    {
        _inUse =
        [
            .. _plans.PlansWithPerson(person.Id),
            .. CalendarText.Use(_coming, DateOnly.FromDateTime(DateTime.Now),
                e => CalendarPeople.TryParse(e.People, out IReadOnlyList<Guid>? ids) && ids?.Contains(person.Id) == true) is { } calendar
                ? [calendar] : Array.Empty<string>(),
        ];
        if (_inUse.Count > 0)
            return;

        bool? confirmed = await Dialogs.ShowMessageBoxAsync(
            title: $"Delete {person.Name}?",
            message: "They go from the household on every device.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        _editing = null;
        await WriteAsync(SyncedEntities.Person, person.Id, OpKind.Delete, []);
    }
}
