@using AshersLab.MealPlanner.Shared.Data.Planning

@*
    Who a plan entry is for, when it is not everyone: a magnet in each person's colour, or (Named) the magnet beside
    their name. Nothing at all for everyone - the common case stays quiet.
*@

@if (People.Count > 0)
{
    <span class="magnets" data-testid="plan-entry-people" title="@string.Join(", ", People.Select(p => p.Name))">
        @foreach (Person person in People)
        {
            if (Named)
            {
                <span class="person-chip"><span class="magnet" style="@($"background:{person.Colour}")"></span>@person.Name</span>
            }
            else
            {
                <span class="magnet" style="@($"background:{person.Colour}")" role="img" aria-label="@person.Name"></span>
            }
        }
    </span>
}

@code {
    [Parameter] public IReadOnlyList<Person> People { get; set; } = [];

    [Parameter] public bool Named { get; set; }
}
