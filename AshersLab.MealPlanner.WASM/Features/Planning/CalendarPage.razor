@page "/calendar"
@using AshersLab.MealPlanner.LocalData
@using AshersLab.MealPlanner.LocalData.Planning
@using AshersLab.MealPlanner.Shared.Data.Meals
@using AshersLab.MealPlanner.Shared.Data.Planning
@using AshersLab.MealPlanner.Shared.Data.Shopping
@using AshersLab.MealPlanner.Shared.Data.Sync
@using AshersLab.MealPlanner.Shared.Domain.Planning
@using AshersLab.MealPlanner.Shared.Domain.Prices
@using AshersLab.MealPlanner.Shared.Domain.Sync
@using AshersLab.MealPlanner.WASM.Data
@using AshersLab.MealPlanner.WASM.Features.Ingredients
@using AshersLab.MealPlanner.WASM.Features.Meals
@using AshersLab.MealPlanner.Shared.Domain.Meals
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@inherits LocalDataPage
@inject IDialogService Dialogs
@inject IBrowserViewportService Viewport
@inject NavigationManager Navigation

@*
    The calendar, the whole week's sheet of the fridge-door pad: what is planned on each real date, filled from a plan
    and changed by hand. The head band carries the week, its stepper and "Fill from a plan". On a desktop the week is a
    grid - slots printed down the side, days across, today's column marked and its date circled in tomato; on a phone a
    day at a time under a strip of the week's days. Meals are in marker, with what a serve costs and the batch's serves
    in small print under them; magnets only when an entry is for some of the household, not everyone. A skipped entry
    stays, struck through, and waits under "To replan" until it is put on another day or removed; one not yet on the
    server has a dashed edge. Under the sheet, the week's two costs as tiles.

    Or the month at a glance (?month=2026-10), for planning a month ahead: a sheet of whole weeks, each day its date and
    a pip per slot - filled where something is planned, tomato where only a skipped entry is, an empty ring where nothing
    is - the days gone by quieter, today circled. On a desktop each day also lists its meals. A day opens the week view
    on that day. The band says what is left to plan of the days to come; under the sheet, those days and the month's food.
*@

<PageTitle>Calendar - Meal Planner</PageTitle>

<LocalDataGate Start="Start">
<div class="cal">
    @if (_applied is not null)
    {
        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _applied = null"
                  data-testid="cal-applied">@_applied</MudAlert>
    }

    <PadSheet Class="cal-pad">
        <Head>
            @if (_month is { } month)
            {
                <h2 data-testid="cal-month-title">@month.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</h2>
                <p data-testid="cal-month-summary">@MonthSummary()</p>
                <div class="cal-step">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Inherit" aria-label="The month before"
                                   OnClick="() => GoToMonth(month.AddMonths(-1))" data-testid="cal-prev"/>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Inherit" aria-label="The month after"
                                   OnClick="() => GoToMonth(month.AddMonths(1))" data-testid="cal-next"/>
                </div>
            }
            else
            {
                <h2 data-testid="cal-week">@CalendarText.Week(_monday)</h2>
                @if (WeeksOnScreen() is { Length: > 0 } weeks)
                {
                    <p data-testid="cal-plan-weeks">@weeks</p>
                }
                <div class="cal-step">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Inherit" aria-label="The week before"
                                   OnClick="() => GoToWeek(_monday.AddDays(-7))" data-testid="cal-prev"/>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Inherit" aria-label="The week after"
                                   OnClick="() => GoToWeek(_monday.AddDays(7))" data-testid="cal-next"/>
                </div>
            }
            <div class="cal-head-actions">
                @* Week or month: two links, so the view is in the address and a reload keeps it. *@
                <nav class="cal-views" aria-label="View">
                    <a href="@WeekLink()" class="@(_month is null ? "is-on" : null)" aria-current="@(_month is null ? "page" : null)"
                       data-testid="cal-view-week">Week</a>
                    <a href="@MonthLink()" class="@(_month is not null ? "is-on" : null)" aria-current="@(_month is not null ? "page" : null)"
                       data-testid="cal-view-month">Month</a>
                </nav>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.EventRepeat" OnClick="ApplyPlan"
                           data-testid="cal-apply">Fill from a plan</MudButton>
                @if (_month is { } shown && shown != MonthGrid.MonthOf(Today))
                {
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Today"
                               OnClick="() => GoToMonth(MonthGrid.MonthOf(Today))" data-testid="cal-this-month">This month</MudButton>
                }
                else if (_month is null && _monday != Rotation.MondayOf(Today))
                {
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Today"
                               OnClick="() => GoToWeek(Rotation.MondayOf(Today))" data-testid="cal-this-week">This week</MudButton>
                }
                @* The household's magnets, as on Today: an entry carries its own only when it is for some of them. *@
                @if (_people.Count > 0)
                {
                    <span class="cal-household" title="@string.Join(", ", _people.Select(p => p.Name))">
                        <PeopleDots People="_people"/>
                    </span>
                }
            </div>
        </Head>
        <ChildContent>
            @if (_slots.Count == 0)
            {
                <p class="pad-note">
                    The day has no slots yet. Add breakfast, lunch, dinner and the rest on <a href="slots">Slots of the day</a>.
                </p>
            }

            @if (_month is { } monthShown)
            {
                @* The month: whole weeks, Monday first; each day a button opening the week view on it. *@
                <div class="mon" data-testid="cal-month">
                    <div class="mon-dows" aria-hidden="true">
                        @foreach (string dow in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                        {
                            <span>@dow</span>
                        }
                    </div>
                    <div class="mon-grid">
                        @foreach (MonthDay day in _monthDays)
                        {
                            <button type="button" class="@MonthDayClass(day, monthShown)" @key="day.Date" @onclick="() => OpenDay(day.Date)"
                                    aria-label="@MonthDayLabel(day)" aria-current="@(day.Date == Today ? "date" : null)"
                                    data-testid="cal-month-day" data-date="@OpValues.FormatDate(day.Date)" data-cover="@day.Cover">
                                <span class="mon-dnum">@day.Date.Day</span>
                                <span class="mon-pips" aria-hidden="true">
                                    @foreach (SlotMark mark in day.Slots)
                                    {
                                        <i class="@($"pip pip-{mark.ToString().ToLowerInvariant()}")" data-testid="cal-month-pip" data-state="@mark"></i>
                                    }
                                </span>
                                <span class="mon-meals" aria-hidden="true">
                                    @foreach (PlannedEntry entry in DayMeals(day.Date).Take(3))
                                    {
                                        <span class="@(entry.Skipped ? "struck" : null)">@MealName(entry.MealId)</span>
                                    }
                                    @if (DayMeals(day.Date).Count() > 3)
                                    {
                                        <span class="mon-more">+@(DayMeals(day.Date).Count() - 3) more</span>
                                    }
                                </span>
                            </button>
                        }
                    </div>
                    <p class="mon-key" aria-hidden="true">
                        <span><i class="pip pip-planned"></i> planned</span>
                        <span><i class="pip pip-empty"></i> nothing yet</span>
                        <span><i class="pip pip-skipped"></i> skipped</span>
                        <span class="mon-key-slots">A dot per slot: @string.Join(", ", _slots.Select(s => s.Name))</span>
                    </p>
                </div>
            }
            else
            {
            @* A desktop: the whole week, slots printed down the side, days across. *@
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <div class="cal-grid-scroll">
                    <table class="cal-grid" data-testid="cal-grid">
                        <thead>
                            <tr>
                                <td class="cal-corner"></td>
                                @foreach (DateOnly date in Days)
                                {
                                    <th class="@DayClass("cal-dayhead", date)" aria-current="@(date == Today ? "date" : null)">
                                        <span class="cal-dow">@(date == Today ? "Today" : Dow(date))</span>
                                        <span class="cal-dnum">@date.Day</span>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Slot slot in _slots)
                            {
                                <tr @key="slot.Id">
                                    <th class="cal-slot-head" scope="row">@slot.Name</th>
                                    @foreach (DateOnly date in Days)
                                    {
                                        <td class="@DayClass("cal-cell", date)" data-testid="cal-cell" data-date="@OpValues.FormatDate(date)" data-slot="@slot.Id">
                                            @foreach (PlannedEntry entry in _calendar.On(date, slot.Id))
                                            {
                                                <div class="@EntryClass(entry)" @key="entry.Id" role="button" tabindex="0"
                                                     @onclick="() => EditEntry(entry)" @onkeydown="e => Key(e, () => EditEntry(entry))"
                                                     data-testid="cal-entry" data-id="@entry.Id" data-skipped="@(entry.Skipped ? "true" : "false")">
                                                    <span class="@MealClass(entry)" data-testid="cal-entry-meal">@MealName(entry.MealId)</span>
                                                    <span class="cal-entry-meta">
                                                        <PeopleDots People="PeopleOf(entry)"/>
                                                        <span data-testid="cal-entry-cost">@CostText(entry)</span>
                                                    </span>
                                                    @if (ServesLine(entry) is { } serves)
                                                    {
                                                        <span class="@ServesClass(entry)" data-testid="cal-entry-serves">@serves</span>
                                                    }
                                                </div>
                                            }
                                            <button type="button" class="cal-add" aria-label="@($"Add to {CalendarText.Day(date)} {slot.Name}")"
                                                    @onclick="() => AddEntry(date, slot)" data-testid="cal-cell-add">
                                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small"/>
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </MudHidden>

            @* A phone: the week's days in a strip, and one day's slots ruled down the sheet. *@
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <div class="cal-strip" role="tablist" aria-label="Days of the week">
                    @foreach (DateOnly d in Days)
                    {
                        DateOnly date = d;
                        <MudButton Variant="@(date == _day ? Variant.Filled : Variant.Text)" Color="Color.Primary"
                                   OnClick="() => _day = date" role="tab" aria-selected="@(date == _day)" Class="@DayClass("cal-day", date)"
                                   data-testid="cal-day" data-date="@OpValues.FormatDate(date)">
                            <span class="cal-day-label"><span class="cal-dow">@Dow(date)</span><span class="cal-dnum">@date.Day</span></span>
                        </MudButton>
                    }
                </div>
                <p class="@(_day == Today ? "cal-day-title is-today" : "cal-day-title")" data-testid="cal-day-title">@CalendarText.LongDay(_day)@(_day == Today ? " · today" : "")</p>
                <div data-testid="cal-day-view">
                    @foreach (Slot slot in _slots)
                    {
                        List<PlannedEntry> entries = [.. _calendar.On(_day, slot.Id)];
                        <div class="pad-row cal-slot" @key="slot.Id" data-testid="cal-cell" data-date="@OpValues.FormatDate(_day)" data-slot="@slot.Id">
                            <span class="pad-label">@slot.Name</span>
                            <div class="pad-entry">
                                @if (entries.Count == 0)
                                {
                                    <button type="button" class="pad-blank cal-blank" @onclick="() => AddEntry(_day, slot)">Nothing planned</button>
                                }
                                @foreach (PlannedEntry entry in entries)
                                {
                                    <div class="@EntryClass(entry)" @key="entry.Id" role="button" tabindex="0"
                                         @onclick="() => EditEntry(entry)" @onkeydown="e => Key(e, () => EditEntry(entry))"
                                         data-testid="cal-entry" data-id="@entry.Id" data-skipped="@(entry.Skipped ? "true" : "false")">
                                        <span class="@MealClass(entry)" data-testid="cal-entry-meal">@MealName(entry.MealId)</span>
                                        <span class="cal-entry-meta">
                                            <PeopleDots People="PeopleOf(entry)" Named="true"/>
                                            <span data-testid="cal-entry-cost">@CostText(entry)</span>
                                        </span>
                                        @if (ServesLine(entry) is { } serves)
                                        {
                                            <span class="@ServesClass(entry)" data-testid="cal-entry-serves">@serves</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="cal-slot-add">
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" aria-label="@($"Add to {slot.Name}")"
                                               OnClick="() => AddEntry(_day, slot)" data-testid="cal-cell-add"/>
                            </div>
                        </div>
                    }
                </div>
            </MudHidden>
            }
        </ChildContent>
    </PadSheet>

    @if (_month is not null)
    {
        @* The month's two numbers: how many of the days to come are planned, and what its food is worth. *@
        <div class="week-tiles cal-tiles" data-testid="cal-month-tiles">
            <div class="week-tile">
                <b data-testid="cal-month-planned">@_toCome.Full of @_toCome.Days</b>
                <span>@(_toCome.Days == 0 ? "days to come - this month has gone" : "days to come fully planned")</span>
            </div>
            <div class="week-tile">
                <b data-testid="cal-month-eaten">@Big(_monthFood)</b>
                <span>@Small(_monthFood, "food this month")</span>
            </div>
        </div>
    }
    else
    {
    @*
        The week's two costs, as the week tiles: what the shop costs (whole packs after the pantry) - which opens the
        week's shopping list - and what the food eaten was worth. An incomplete cost keeps its unpriced count right under
        the number.
    *@
    <div class="week-tiles cal-tiles" data-testid="cal-week-cost">
        <a class="week-tile cal-tile-link" href="@($"shopping?from={OpValues.FormatDate(_monday)}&to={OpValues.FormatDate(_monday.AddDays(6))}")"
           data-testid="cal-shopping">
            <b data-testid="cal-week-spend">@Big(_week.Spend)</b>
            <span>@Small(_week.Spend, "the shop this week")</span>
            <span class="cal-tile-go">Shopping list <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"/></span>
        </a>
        <div class="week-tile">
            <b data-testid="cal-week-eaten">@Big(_week.Eaten)</b>
            <span>@Small(_week.Eaten, "food eaten this week")</span>
        </div>
    </div>

    @if (ServesNotes() is { Count: > 0 } notes)
    {
        <PadSheet Title="Serves" Class="cal-below" TestId="cal-serves">
            @foreach ((string note, bool problem) in notes)
            {
                <div class="@(problem ? "cal-note cal-note-problem" : "cal-note")" data-testid="cal-serves-note" data-problem="@(problem ? "true" : "false")">
                    <MudIcon Icon="@(problem ? Icons.Material.Filled.ErrorOutline : Icons.Material.Filled.Info)" Size="Size.Small"
                             Color="@(problem ? Color.Error : Color.Primary)"/>
                    <span>@note</span>
                </div>
            }
        </PadSheet>
    }
    }

    @if (_calendar.ToReplan.Count > 0)
    {
        <PadSheet Title="To replan" Subtitle="Skipped. Tap one to put it on another day, or remove it." Class="cal-below" TestId="cal-replan">
            @foreach (PlannedEntry entry in _calendar.ToReplan)
            {
                <div class="@(_unsent.Contains(entry.Id) ? "pad-row cal-replan-row unsent" : "pad-row cal-replan-row")" @key="entry.Id" role="button" tabindex="0"
                     @onclick="() => EditEntry(entry)" @onkeydown="e => Key(e, () => EditEntry(entry))"
                     data-testid="cal-replan-entry" data-id="@entry.Id">
                    <span class="pad-label">@CalendarText.Day(entry.Day)<br/>@SlotName(entry.SlotId)</span>
                    <div class="pad-entry">
                        <span class="marker struck">@MealName(entry.MealId)</span>
                    </div>
                </div>
            }
        </PadSheet>
    }
</div>
</LocalDataGate>

@code {
    /// <summary>"2026-10-26": the week shown, so a link or a reload keeps it.</summary>
    [SupplyParameterFromQuery(Name = "week")] public string? WeekParameter { get; set; }

    /// <summary>"2026-10-29": the day the phone's week view opens on - a day tapped on the month.</summary>
    [SupplyParameterFromQuery(Name = "day")] public string? DayParameter { get; set; }

    /// <summary>"2026-10": the month at a glance instead of the week.</summary>
    [SupplyParameterFromQuery(Name = "month")] public string? MonthParameter { get; set; }

    private CalendarBook             _calendar = null!;
    private ServesBook               _serves   = null!;
    private MealCostBook             _costs    = null!;
    private ShoppingBook             _week     = null!;
    private List<Slot>               _slots    = [];
    private List<Person>             _people   = [];
    private Dictionary<Guid, Meal>   _meals    = [];
    private List<MealGroup>          _groups   = [];
    private HashSet<Guid>            _unsent   = [];

    private DateOnly  _monday = Rotation.MondayOf(Today);
    private DateOnly  _day    = Today;
    private DateOnly? _month;   // the first of the month shown, in the month view
    private string?   _applied;

    // The month view's days, what is left to plan of them, and the month's food.
    private List<MonthDay> _monthDays = [];
    private MonthToCome    _toCome    = new(0, 0, 0, 0);
    private Cost           _monthFood;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private IEnumerable<DateOnly> Days => Enumerable.Range(0, 7).Select(i => _monday.AddDays(i));

    protected override async Task OnParametersSetAsync()
    {
        DateOnly? month = DateOnly.TryParseExact(MonthParameter, "yyyy-MM", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly m) ? m : null;
        DateOnly monday = OpValues.TryParseDate(WeekParameter, out DateOnly week) ? Rotation.MondayOf(week) : Rotation.MondayOf(Today);
        bool changed = month != _month || monday != _monday;
        if (OpValues.TryParseDate(DayParameter, out DateOnly day) && Rotation.MondayOf(day) == monday)
            _day = day;
        else if (monday != _monday)
            _day = monday == Rotation.MondayOf(Today) ? Today : monday;
        (_month, _monday) = (month, monday);
        if (changed && Ready)
            await Reload();
    }

    protected override async Task LoadAsync(LocalDbContext db)
    {
        _slots    = [.. Slot.InOrder(await db.Slots.AsNoTracking().Where(s => !s.Deleted).ToListAsync())];
        _people   = [.. Person.InOrder(await db.People.AsNoTracking().Where(p => !p.Deleted).ToListAsync())];
        _meals    = await db.Meals.AsNoTracking().Where(m => !m.Deleted).ToDictionaryAsync(m => m.Id);
        _groups   = [.. MealGroupEntity.InOrder(await db.MealGroups.AsNoTracking().Where(g => !g.Deleted).ToListAsync())];
        _unsent   = [.. await db.Outbox.AsNoTracking().Select(o => o.EntityId).ToListAsync()];

        if (_month is { } month)
        {
            IReadOnlyList<DateOnly> days = MonthGrid.Days(month);
            _calendar  = await CalendarBook.LoadAsync(db, days[0], days[^1]);
            // "To replan" opens the entry sheet here too, which offers a leftovers entry its batches.
            _serves    = await ServesBook.LoadAsync(db, days[0], days[^1]);
            _costs     = await MealCostBook.LoadAsync(db);
            List<Guid> slots = [.. _slots.Select(s => s.Id)];
            _monthDays = [.. days.Select(d => MonthGrid.Mark(d, slots, _calendar.On(d).Select(e => (e.SlotId, e.Skipped))))];
            _toCome    = MonthGrid.ToCome(month, _monthDays, Today);
            _monthFood = (await ShoppingBook.LoadAsync(db, month, MonthGrid.LastOf(month))).Eaten;
            return;
        }

        _calendar = await CalendarBook.LoadAsync(db, _monday, _monday.AddDays(6));
        _serves   = await ServesBook.LoadAsync(db, _monday, _monday.AddDays(6));
        _costs    = await MealCostBook.LoadAsync(db);
        _week     = await ShoppingBook.LoadAsync(db, _monday, _monday.AddDays(6));
    }

    private void GoToWeek(DateOnly monday) => Navigation.NavigateTo($"calendar?week={OpValues.FormatDate(monday)}");

    private void GoToMonth(DateOnly month) => Navigation.NavigateTo(MonthLink(month));

    private static string MonthLink(DateOnly month) => $"calendar?month={month.ToString("yyyy-MM", CultureInfo.InvariantCulture)}";

    /// <summary>From the week: the month of the day on screen. From the month: itself.</summary>
    private string MonthLink() => MonthLink(_month ?? MonthGrid.MonthOf(_day));

    /// <summary>From the month: this week when it is this month, else the week of its 1st. From the week: itself.</summary>
    private string WeekLink() =>
        _month is { } month && month != MonthGrid.MonthOf(Today)
            ? $"calendar?week={OpValues.FormatDate(Rotation.MondayOf(month))}&day={OpValues.FormatDate(month)}"
            : _month is null ? $"calendar?week={OpValues.FormatDate(_monday)}&day={OpValues.FormatDate(_day)}" : "calendar";

    /// <summary>A day tapped on the month: the week view, on that day.</summary>
    private void OpenDay(DateOnly date) =>
        Navigation.NavigateTo($"calendar?week={OpValues.FormatDate(Rotation.MondayOf(date))}&day={OpValues.FormatDate(date)}");

    /// <summary>
    /// A day's meals for the month's list on a desktop: what is cooked first - what a month's planning is mostly about -
    /// then the rest, each in slot order.
    /// </summary>
    private IEnumerable<PlannedEntry> DayMeals(DateOnly date) =>
        _slots.SelectMany(s => _calendar.On(date, s.Id))
            .Where(e => e.MealId is not null)
            .OrderBy(e => _meals.GetValueOrDefault(e.MealId!.Value)?.Kind == MealKind.Cooked ? 0 : 1);

    /// <summary>The band under the month's name: "10 days to come: 4 planned, 2 with gaps, 4 with nothing yet."</summary>
    private string MonthSummary() => _toCome switch
    {
        { Days: 0 } => "All gone by.",
        var c       => $"{c.Days} {(c.Days == 1 ? "day" : "days")} to come: " + string.Join(", ", new[]
        {
            $"{(c.Full == c.Days ? "all" : c.Full.ToString(CultureInfo.InvariantCulture))} planned",
            c.Partial > 0 ? $"{c.Partial} with gaps" : null,
            c.Empty > 0 ? $"{c.Empty} with nothing yet" : null,
        }.Where(p => p is not null)) + ".",
    };

    private static string MonthDayClass(MonthDay day, DateOnly month) =>
        string.Join(' ', new[]
        {
            "mon-day",
            $"is-{day.Cover.ToString().ToLowerInvariant()}",
            day.Date == Today ? "is-today" : day.Date < Today ? "is-past" : null,
            MonthGrid.MonthOf(day.Date) != month ? "is-other" : null,
        }.Where(c => c is not null));

    /// <summary>"Tuesday 27 October: 2 of 3 planned, 1 skipped".</summary>
    private static string MonthDayLabel(MonthDay day)
    {
        int planned = day.Slots.Count(s => s == SlotMark.Planned), skipped = day.Slots.Count(s => s == SlotMark.Skipped);
        return $"{CalendarText.LongDay(day.Date)}: {planned} of {day.Slots.Count} planned{(skipped > 0 ? $", {skipped} skipped" : "")}";
    }

    /// <summary>"Spreadsheet plan: week 3" for each plan this week's entries came from.</summary>
    private string WeeksOnScreen() =>
        string.Join(" · ", _calendar.Plans.Templates.Where(t => t.RotationOn(_monday).StartsOn is not null && Days.Any(d => _calendar.On(d).Any(e => e.Template?.Id == t.Id)))
            .Select(t => t.RotationOn(_monday) is ({ } starts, int weeks) ? $"{t.Name}: week {Rotation.WeekOf(starts, weeks, _monday)}" : t.Name));

    /// <summary>"Tue".</summary>
    private static string Dow(DateOnly date) => date.ToString("ddd", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>A day's column, header or strip button: marked when it is today, quieter once it has gone.</summary>
    private static string DayClass(string name, DateOnly date) =>
        date == Today ? $"{name} is-today" : date < Today ? $"{name} is-past" : name;

    /// <summary>Not yet on the server: the dashed edge.</summary>
    private string EntryClass(PlannedEntry entry) => _unsent.Contains(entry.Id) ? "cal-entry unsent" : "cal-entry";

    /// <summary>The meal in marker; a skipped one struck through, in place.</summary>
    private static string MealClass(PlannedEntry entry) => entry.Skipped ? "marker cal-meal struck" : "marker cal-meal";

    /// <summary>The tile's number: what is known, or "$?" with nothing priced at all - never "$0.00".</summary>
    private static string Big(Cost cost) => cost.Cents == 0 && cost.Missing > 0 ? "$?" : Money.Format(cost.Cents);

    /// <summary>What the tile counts, and how many things it could not price.</summary>
    private static string Small(Cost cost, string what) => cost.Missing switch
    {
        0 => what,
        _ => $"{what} · {cost.Missing} unpriced",
    };

    private static Task Key(KeyboardEventArgs e, Func<Task> act) => e.Key == "Enter" ? act() : Task.CompletedTask;

    private string MealName(Guid? meal) => meal is { } id ? _meals.GetValueOrDefault(id)?.Name ?? "meal removed" : "nothing chosen";

    private string SlotName(Guid slot) => _slots.FirstOrDefault(s => s.Id == slot)?.Name ?? "a removed slot";

    /// <summary>What a serve costs - for leftovers, a serve of the batch they eat.</summary>
    private string CostText(PlannedEntry entry) =>
        entry.Skipped ? "skipped"
        : _serves.LeftoversOf(entry.Id) is { Got: > 0, BatchId: { } batch } && BatchMeal(batch) is { } eaten ? CalendarText.Serve(eaten, _costs.CostOf(eaten))
        : entry.MealId is { } id && _meals.GetValueOrDefault(id) is { } meal ? CalendarText.Serve(meal, _costs.CostOf(meal))
        : "";

    private Meal? BatchMeal(Guid? batch) => batch is { } b && _serves.Entry(b)?.MealId is { } m ? _meals.GetValueOrDefault(m) : null;

    private DateOnly? BatchDay(Guid? batch) => batch is { } b ? _serves.Entry(b)?.Day : null;

    /// <summary>A batch's serves under a cooked entry, or what a leftovers entry eats; nothing for a skipped entry or any other meal.</summary>
    private string? ServesLine(PlannedEntry entry) =>
        entry.Skipped ? null
        : _serves.BatchOf(entry.Id) is { } batch ? ServesText.Batch(batch)
        : _serves.LeftoversOf(entry.Id) is { } eats ? ServesText.Leftovers(eats, BatchMeal(eats.BatchId)?.Name, BatchDay(eats.BatchId))
        : null;

    /// <summary>The serves line; <c>cal-serves-problem</c> (read by the check scripts) when it has less than it needs.</summary>
    private string ServesClass(PlannedEntry entry) =>
        _serves.LeftoversOf(entry.Id) is { Problem: not LeftoversProblem.None } || _serves.BatchOf(entry.Id) is { Short: > 0 }
            ? "cal-serves cal-serves-problem" : "cal-serves";

    /// <summary>
    /// The week's serves, in calendar order: every leftovers entry with less than it needs ("Saturday's leftovers has
    /// nothing to eat"), then every batch cooked this week with serves nobody is planned to eat ("2 serves ... will go uneaten").
    /// </summary>
    private List<(string Note, bool Problem)> ServesNotes()
    {
        Dictionary<Guid, int> slotOrder = _slots.Select((s, i) => (s.Id, i)).ToDictionary(p => p.Id, p => p.i);
        List<PlannedEntry> week = [.. Days.SelectMany(d => _calendar.On(d)).OrderBy(e => e.Day).ThenBy(e => slotOrder.GetValueOrDefault(e.SlotId, int.MaxValue))];

        List<(string, bool)> notes = [];
        foreach (PlannedEntry entry in week)
            if (_serves.LeftoversOf(entry.Id) is { Problem: not LeftoversProblem.None } eats)
                notes.Add((ServesText.LeftoversNote(entry.Day, eats, BatchMeal(eats.BatchId)?.Name, BatchDay(eats.BatchId)), true));
        foreach (PlannedEntry entry in week)
            if (_serves.BatchOf(entry.Id) is { Cooked: true, Left: > 0 } batch)
                notes.Add((ServesText.UneatenNote(batch, MealName(entry.MealId)), false));
        return notes;
    }

    /// <summary>The batches a leftovers entry can be set to eat, for the sheet's "Eats from".</summary>
    private List<PickerOption> BatchOptions(PlannedEntry entry) =>
        [.. _serves.ChoicesFor(entry).Select(c => new PickerOption(c.Id, ServesText.Choice(MealName(c.MealId), c.Day, c.LeftBefore)))];

    private IReadOnlyList<Person> PeopleOf(PlannedEntry entry) =>
        entry.People is { } ids ? [.. _people.Where(p => ids.Contains(p.Id))] : [];

    private List<PickerOption> MealOptions() =>
        [.. _meals.Values.OrderBy(m => m.Name, StringComparer.CurrentCultureIgnoreCase).Select(m => new PickerOption(m.Id, m.Name))];

    private Dictionary<Guid, MealServesOption> MealServes() =>
        _meals.Values.ToDictionary(m => m.Id, m => new MealServesOption(m.Kind, m.ServesPerBatch));

    private List<PersonOption> PersonOptions() => [.. _people.Select(p => new PersonOption(p.Id, p.Name, p.Colour))];

    private List<PickerOption> SlotOptions() => [.. _slots.Select(s => new PickerOption(s.Id, s.Name))];

    private async Task AddEntry(DateOnly date, Slot slot)
    {
        CalendarEntryDraft start = new(null, null, false, date, slot.Id);
        CalendarEntrySheetResult? result;
        while (true)
        {
            result = await PlanDialogs.EditCalendarEntryAsync(Dialogs, Viewport,
                start, isNew: true, $"{CalendarText.LongDay(date)} · {slot.Name}", null,
                [], MealOptions(), PersonOptions(), SlotOptions(), MealServes(), []);
            if (result is not { NewMeal: { } name, Saved: { } sofar })
                break;

            // The meal editor, as on the Meals page; saved, the sheet opens again with the new meal chosen and who eats it
            // as it was. Its ingredients can wait: its cost says "no ingredients yet" until they are added.
            MealEditorResult? newMeal = await MealDialogs.EditAsync(Dialogs, Viewport,
                new MealDraft(name, null, MealKind.Cooked, 1, null, null), isNew: true,
                [.. _groups.Select(g => new PickerOption(g.Id, g.Name))], [.. _meals.Values.Select(m => m.Name)]);
            start = sofar;
            if (newMeal?.Saved is { } mealDraft)
            {
                Guid mealId = Guid.CreateVersion7();
                await WriteAsync(SyncedEntities.Meal, mealId, OpKind.Create, mealDraft.FieldsChangedFrom(null));
                start = sofar with { Meal = mealId };
            }
        }
        if (result?.Saved is not { Meal: { } meal } draft)
            return;

        await WriteAsync(SyncedEntities.CalendarEntry, Guid.CreateVersion7(), OpKind.Create,
        [
            new OpField(CalendarEntryRules.DateField, OpValues.FormatDate(draft.Day)),
            new OpField(CalendarEntryRules.SlotField, OpValues.FormatId(draft.Slot)),
            new OpField(CalendarEntryRules.MealField, OpValues.FormatId(meal)),
            .. CalendarPeople.Field(draft.People, null) is { } people ? [new OpField(CalendarEntryRules.PeopleField, people)] : Array.Empty<OpField>(),
            .. draft.ServesMade is { } made ? [new OpField(CalendarEntryRules.ServesMadeField, OpValues.FormatInt(made))] : Array.Empty<OpField>(),
        ]);
    }

    private async Task EditEntry(PlannedEntry entry)
    {
        string? source = entry.Template is { } t && entry.TemplateEntry is { } te
            ? $"From {t.Name}{(t.WeekCount > 1 ? $" · week {te.Week}" : "")}"
            : entry.Row.TemplateEntryId is not null ? "From a plan entry since removed" : null;
        CalendarEntrySheetResult? result = await PlanDialogs.EditCalendarEntryAsync(Dialogs, Viewport,
            new CalendarEntryDraft(entry.MealId, entry.People, entry.Skipped, entry.Day, entry.SlotId, entry.Row.EatsFrom, entry.Row.ServesMade), isNew: false,
            $"{CalendarText.LongDay(entry.Day)} · {SlotName(entry.SlotId)}", source,
            [.. entry.Choices.Select(c => new PickerOption(c, MealName(c)))], MealOptions(), PersonOptions(), SlotOptions(),
            MealServes(), BatchOptions(entry));

        if (result is { Remove: true })
        {
            // A tombstone: applying the plan again does not bring it back.
            await WriteAsync(SyncedEntities.CalendarEntry, entry.Id, OpKind.Delete, []);
            return;
        }
        if (result?.Saved is not { } draft)
            return;

        IReadOnlyList<OpField> fields = draft.ChangesFrom(entry.Now);
        if (fields.Count > 0)
            await WriteAsync(SyncedEntities.CalendarEntry, entry.Id, OpKind.Update, fields);
        if (draft.Day < _monday || draft.Day > _monday.AddDays(6))
            GoToWeek(Rotation.MondayOf(draft.Day));
        else
            _day = draft.Day;
    }

    private async Task ApplyPlan()
    {
        // From the week on screen; from the month, its first week - or this week, for this month: filling the days gone by
        // would count meals nobody planned as eaten. The month offers its remaining weeks.
        DateOnly from = _monday;
        int offer = 1;
        if (_month is { } month)
        {
            from = Rotation.MondayOf(month) < Rotation.MondayOf(Today) && MonthGrid.LastOf(month) >= Today ? Rotation.MondayOf(Today) : Rotation.MondayOf(month);
            offer = (Rotation.MondayOf(MonthGrid.LastOf(month)).DayNumber - from.DayNumber) / 7 + 1;
        }

        // The week this one was, by the rotation it had then - an earlier one's, for a week before the plan last changed.
        List<ApplyPlanOption> plans = [.. _calendar.Plans.Templates.Select(t => new ApplyPlanOption(t.Id, t.Name, t.WeekCount,
            t.RotationOn(from) is ({ } starts, int weeks) ? Math.Min(Rotation.WeekOf(starts, weeks, from), t.WeekCount) : 1))];
        if (await PlanDialogs.ApplyPlanAsync(Dialogs, Viewport, plans, from, Math.Max(1, offer)) is not { } answer)
            return;

        PlanTemplate template = _calendar.Plans.Template(answer.Plan)!;
        DateOnly starts = Rotation.StartFor(from, answer.Week, template.WeekCount);
        CalendarApplyPlan? plan;
        await using (LocalDbContext db = await Database.Contexts.CreateDbContextAsync())
            plan = await CalendarApply.PlanAsync(db, answer.Plan, starts, from, from.AddDays(7 * answer.Count - 1));
        if (plan is null)
            return;

        await WriteAllAsync(plan.Edits);
        int added = plan.Result.Create.Count, there = plan.Result.AlreadyThere;
        _applied = $"{template.Name}: added {added} {(added == 1 ? "entry" : "entries")}"
                   + (there > 0 ? $"; {there} already on the calendar, left as they are." : ".");
    }
}
