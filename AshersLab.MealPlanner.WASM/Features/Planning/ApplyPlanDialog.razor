@using AshersLab.MealPlanner.WASM.Features.Ingredients

@*
    Fill the calendar from a plan: which plan, which of its weeks the week on screen is, and for how many weeks. The plan
    remembers the answer, so next time it is already right. Applying again never changes an entry already there - it only
    adds what is missing.
*@

<MudDialog data-testid="apply-dialog">
    <DialogContent>
        @if (Plans.Count == 0)
        {
            <p class="apply-note" data-testid="apply-no-plans">
                There are no plans yet. Make one on Plans - a week or more of meals that repeats - and fill the calendar from it here.
            </p>
        }
        else
        {
            <label class="native-select">
                <span>Plan</span>
                <select value="@_plan" @onchange="PlanChanged" data-testid="apply-plan">
                    @foreach (ApplyPlanOption plan in Plans)
                    {
                        <option value="@plan.Id">@plan.Name</option>
                    }
                </select>
            </label>
            @if (Chosen.Weeks > 1)
            {
                <label class="native-select mt-4">
                    <span>The week of @CalendarText.Day(Monday) is</span>
                    <select @bind="_week" data-testid="apply-week">
                        @for (int w = 1; w <= Chosen.Weeks; w++)
                        {
                            <option value="@w">Week @w</option>
                        }
                    </select>
                </label>
            }
            <label class="native-select mt-4">
                <span>Fill</span>
                <select @bind="_count" data-testid="apply-count">
                    @foreach (int n in Counts)
                    {
                        <option value="@n">@(n == 1 ? "this week" : $"{n} weeks from this one")</option>
                    }
                </select>
            </label>
            <p class="apply-note">Anything already on the calendar stays as it is - only what is missing is added.</p>
        }
    </DialogContent>
    <DialogActions>
        @if (Plans.Count == 0)
        {
            <MudButton Href="plans" Variant="Variant.Text" Color="Color.Primary" Class="mr-auto">Go to Plans</MudButton>
        }
        <MudButton OnClick="() => Dialog.Cancel()" data-testid="apply-cancel">Cancel</MudButton>
        <MudButton OnClick="Apply" Disabled="Plans.Count == 0" Color="Color.Primary" Variant="Variant.Filled" data-testid="apply-run">Fill</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public IReadOnlyList<ApplyPlanOption> Plans { get; set; } = [];

    /// <summary>The Monday of the week on screen.</summary>
    [Parameter] public DateOnly Monday { get; set; }

    /// <summary>How many weeks to offer first: one from the week view, the rest of the month from the month view.</summary>
    [Parameter] public int Weeks { get; set; } = 1;

    /// <summary>Up to six weeks, enough for any month, then longer plans' lengths.</summary>
    private static readonly int[] Counts = [1, 2, 3, 4, 5, 6, 8, 12];

    private Guid _plan;
    private int  _week = 1;
    private int  _count = 1;

    private ApplyPlanOption Chosen => Plans.First(p => p.Id == _plan);

    protected override void OnInitialized()
    {
        _count = Counts.FirstOrDefault(n => n >= Weeks, Counts[^1]);
        if (Plans.Count == 0)
            return;
        _plan = Plans[0].Id;
        _week = Plans[0].WeekOnScreen;
    }

    private void PlanChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out Guid id) && Plans.Any(p => p.Id == id))
        {
            _plan = id;
            _week = Chosen.WeekOnScreen;
        }
    }

    private void Apply() => Dialog.Close(DialogResult.Ok(new ApplyPlanResult(_plan, Math.Clamp(_week, 1, Chosen.Weeks), _count)));
}
