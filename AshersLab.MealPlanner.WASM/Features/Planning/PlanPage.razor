@page "/plans/{Id:guid}"
@using AshersLab.MealPlanner.LocalData
@using AshersLab.MealPlanner.LocalData.Sync
@using AshersLab.MealPlanner.Shared.Data.Planning
@using AshersLab.MealPlanner.Shared.Data.Sync
@using AshersLab.MealPlanner.Shared.Domain.Planning
@using AshersLab.MealPlanner.Shared.Domain.Sync
@using AshersLab.MealPlanner.WASM.Data
@using AshersLab.MealPlanner.WASM.Features.Ingredients
@using Microsoft.EntityFrameworkCore
@inherits LocalDataPage
@inject IDialogService Dialogs
@inject IBrowserViewportService Viewport
@inject NavigationManager Navigation

@*
    One plan template, a week at a time: the pad's master copy, in the calendar's grid language. The head band carries
    the plan's name and Edit; a plan of more than one week has a strip of its weeks under it. On a desktop the week is a
    grid - slots printed down the side, days across - with every entry in marker in its cell; on a phone, a day at a
    time under a strip of the days. Tapping an entry opens its sheet; a slot's + adds one. Each entry is its own op (with
    its choices, written together), so two phones planning different days both keep theirs; one not yet on the server
    has a dashed edge.
*@

<PageTitle>@(_template?.Name ?? "Plan") - Meal Planner</PageTitle>

@* The phone's app bar has its own back arrow; a desktop keeps this one. *@
<div class="plan-back">
    <MudButton Href="plans" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack"
               data-testid="plan-back">Plans</MudButton>
</div>

<div class="plan">
<LocalDataGate Start="Start">
    @if (_template is null)
    {
        <PadSheet>
            <p class="pad-note" data-testid="plan-gone">
                This plan is not here - it may have been deleted on another device. See the others on <a href="plans">Plans</a>.
            </p>
        </PadSheet>
    }
    else
    {
        <PadSheet Class="plan-pad">
            <Head>
                <h2 data-testid="plan-title">@_template.Name</h2>
                <p data-testid="plan-summary">@PlanText.Weeks(_template.WeekCount), then it repeats</p>
                <div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditPlan"
                               data-testid="plan-edit">Edit</MudButton>
                </div>
            </Head>
            <ChildContent>
                @if (_template.WeekCount > 1)
                {
                    <div class="plan-weeks" role="tablist" aria-label="Weeks of the plan">
                        @for (int w = 1; w <= _template.WeekCount; w++)
                        {
                            int week = w;
                            <MudButton Variant="@(week == _week ? Variant.Filled : Variant.Text)" Color="Color.Primary"
                                       OnClick="() => _week = week" role="tab" aria-selected="@(week == _week)"
                                       data-testid="plan-week" data-week="@week">Week @week</MudButton>
                        }
                    </div>
                }

                @if (_slots.Count == 0)
                {
                    <p class="pad-note">
                        The day has no slots yet. Add breakfast, lunch, dinner and the rest on <a href="slots">Slots of the day</a>.
                    </p>
                }

                @* A desktop: the whole week, slots printed down the side, days across. *@
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <div class="tpl-scroll">
                        <table class="tpl-grid" data-testid="plan-grid">
                            <thead>
                                <tr>
                                    <td class="plan-corner"></td>
                                    @foreach (DayOfWeek day in PlanDays.Week)
                                    {
                                        <th class="plan-dayhead">@PlanDays.Short(day)</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (Slot slot in _slots)
                                {
                                    <tr @key="slot.Id">
                                        <th class="plan-slot-head" scope="row">@slot.Name</th>
                                        @foreach (DayOfWeek day in PlanDays.Week)
                                        {
                                            <td class="plan-cell" data-testid="plan-cell" data-day="@day" data-slot="@slot.Id">
                                                @foreach (TemplateEntry entry in EntriesAt(day, slot.Id))
                                                {
                                                    <div class="@EntryClass(entry)" @key="entry.Id" role="button" tabindex="0"
                                                         @onclick="() => EditEntry(entry, day, slot)" @onkeydown="e => Key(e, () => EditEntry(entry, day, slot))"
                                                         data-testid="plan-entry" data-id="@entry.Id">
                                                        <span class="marker plan-meals" data-testid="plan-entry-meals">@EntryText(entry)</span>
                                                        <PeopleDots People="PeopleOf(entry)"/>
                                                    </div>
                                                }
                                                <button type="button" class="tpl-add"aria-label="@($"Add to {PlanDays.Format(day)} {slot.Name}")"
                                                        @onclick="() => AddEntry(day, slot)" data-testid="plan-cell-add">
                                                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small"/>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </MudHidden>

                @* A phone: the days in a strip, and one day's slots ruled down the sheet. *@
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <div class="plan-strip" role="tablist" aria-label="Days of the week">
                        @foreach (DayOfWeek d in PlanDays.Week)
                        {
                            DayOfWeek day = d;
                            <MudButton Variant="@(day == _day ? Variant.Filled : Variant.Text)" Color="Color.Primary"
                                       OnClick="() => _day = day" role="tab" aria-selected="@(day == _day)" Class="tpl-day"
                                       data-testid="plan-day" data-day="@day">@PlanDays.Short(day)</MudButton>
                        }
                    </div>
                    <p class="plan-day-title">@(_template.WeekCount > 1 ? $"Week {_week} · {PlanDays.Format(_day)}" : PlanDays.Format(_day))</p>
                    <div data-testid="plan-day-view">
                        @foreach (Slot slot in _slots)
                        {
                            List<TemplateEntry> entries = [.. EntriesAt(_day, slot.Id)];
                            <div class="pad-row plan-slot" @key="slot.Id" data-testid="plan-cell" data-day="@_day" data-slot="@slot.Id">
                                <span class="pad-label">@slot.Name</span>
                                <div class="pad-entry">
                                    @if (entries.Count == 0)
                                    {
                                        <button type="button" class="pad-blank plan-blank" @onclick="() => AddEntry(_day, slot)">Nothing planned</button>
                                    }
                                    @foreach (TemplateEntry entry in entries)
                                    {
                                        <div class="@EntryClass(entry)" @key="entry.Id" role="button" tabindex="0"
                                             @onclick="() => EditEntry(entry, _day, slot)" @onkeydown="e => Key(e, () => EditEntry(entry, _day, slot))"
                                             data-testid="plan-entry" data-id="@entry.Id">
                                            <span class="marker plan-meals" data-testid="plan-entry-meals">@EntryText(entry)</span>
                                            <div class="pad-entry-meta">
                                                <PeopleDots People="PeopleOf(entry)" Named="true"/>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="plan-slot-add">
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" aria-label="@($"Add to {slot.Name}")"
                                                   OnClick="() => AddEntry(_day, slot)" data-testid="plan-cell-add"/>
                                </div>
                            </div>
                        }
                    </div>
                </MudHidden>
            </ChildContent>
        </PadSheet>
    }
</LocalDataGate>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private PlanTemplate?             _template;
    private PlanBook                  _plans  = null!;
    private List<Slot>                _slots  = [];
    private List<Person>              _people = [];
    private Dictionary<Guid, string>  _meals  = [];
    private HashSet<Guid>             _unsent = [];

    private int       _week = 1;
    private DayOfWeek _day  = DayOfWeek.Monday;

    protected override async Task OnParametersSetAsync()
    {
        if (Ready)
            await Reload();
    }

    protected override async Task LoadAsync(LocalDbContext db)
    {
        _plans    = await PlanBook.LoadAsync(db);
        _template = _plans.Template(Id);
        _slots    = [.. Slot.InOrder(await db.Slots.AsNoTracking().Where(s => !s.Deleted).ToListAsync())];
        _people   = [.. Person.InOrder(await db.People.AsNoTracking().Where(p => !p.Deleted).ToListAsync())];
        _meals    = await db.Meals.AsNoTracking().Where(m => !m.Deleted).ToDictionaryAsync(m => m.Id, m => m.Name);
        _unsent   = [.. await db.Outbox.AsNoTracking().Select(o => o.EntityId).ToListAsync()];
        if (_template is not null && _week > _template.WeekCount)
            _week = 1;
    }

    private IEnumerable<TemplateEntry> EntriesAt(DayOfWeek day, Guid slot) =>
        _plans.EntriesOf(Id).Where(e => e.Week == _week && e.Day == day && e.SlotId == slot);

    private string EntryText(TemplateEntry entry) =>
        _plans.ChoicesOf(entry.Id) is { Count: > 0 } choices
            ? PlanText.Choices(choices.Select(c => _meals.GetValueOrDefault(c.MealId, "meal removed")))
            : "nothing chosen";

    /// <summary>Not yet on the server - the entry or any of its choices: the dashed edge.</summary>
    private string EntryClass(TemplateEntry entry) =>
        _unsent.Contains(entry.Id) || _plans.ChoicesOf(entry.Id).Any(c => _unsent.Contains(c.Id)) ? "tpl-entry unsent" : "tpl-entry";

    private static Task Key(KeyboardEventArgs e, Func<Task> act) => e.Key == "Enter" ? act() : Task.CompletedTask;

    /// <summary>The people it names, live ones only; empty for everyone.</summary>
    private IReadOnlyList<Person> PeopleOf(TemplateEntry entry) =>
        entry.PeopleIds() is { } ids ? [.. _people.Where(p => ids.Contains(p.Id))] : [];

    private string Where(DayOfWeek day, Slot slot) =>
        string.Join(" · ", new[] { _template!.WeekCount > 1 ? $"Week {_week}" : null, PlanDays.Format(day), slot.Name }.OfType<string>());

    private List<PickerOption> MealOptions() =>
        [.. _meals.OrderBy(m => m.Value, StringComparer.CurrentCultureIgnoreCase).Select(m => new PickerOption(m.Key, m.Value))];

    private List<PersonOption> PersonOptions() => [.. _people.Select(p => new PersonOption(p.Id, p.Name, p.Colour))];

    private async Task AddEntry(DayOfWeek day, Slot slot)
    {
        int week = _week;
        IReadOnlyList<Guid>? people = SlotRules.NewEntryPeople(slot.PeopleIds(), _people.Select(p => p.Id));
        TemplateEntrySheetResult? result = await PlanDialogs.EditEntryAsync(Dialogs, Viewport, new TemplateEntryDraft([], people),
            isNew: true, Where(day, slot), MealOptions(), PersonOptions());
        if (result?.Saved is not { } draft)
            return;

        Guid entry = Guid.CreateVersion7();
        TemplateEntryChange change = draft.ChangesFrom(null);
        await WriteAllAsync(
        [
            new LocalEdit(SyncedEntities.TemplateEntry, entry, OpKind.Create,
            [
                new OpField(TemplateEntryRules.TemplateField, OpValues.FormatId(Id)),
                new OpField(TemplateEntryRules.WeekField, OpValues.FormatInt(week)),
                new OpField(TemplateEntryRules.DayField, PlanDays.Format(day)),
                new OpField(TemplateEntryRules.SlotField, OpValues.FormatId(slot.Id)),
                .. change.EntryFields,
            ]),
            .. ChoiceCreates(entry, change.AddMeals),
        ]);
    }

    private async Task EditEntry(TemplateEntry entry, DayOfWeek day, Slot slot)
    {
        IReadOnlyList<TemplateChoice> rows = _plans.ChoicesOf(entry.Id);
        TemplateEntrySheetResult? result = await PlanDialogs.EditEntryAsync(Dialogs, Viewport,
            new TemplateEntryDraft([.. rows.Select(c => c.MealId)], entry.PeopleIds()),
            isNew: false, Where(day, slot), MealOptions(), PersonOptions());

        if (result is { Remove: true })
        {
            await WriteAllAsync(
            [
                new LocalEdit(SyncedEntities.TemplateEntry, entry.Id, OpKind.Delete, []),
                .. rows.Select(c => new LocalEdit(SyncedEntities.TemplateChoice, c.Id, OpKind.Delete, [])),
            ]);
            return;
        }
        if (result?.Saved is not { } draft)
            return;

        TemplateEntryChange change = draft.ChangesFrom((entry.PeopleIds(), [.. rows.Select(c => (c.Id, c.MealId))]));
        if (change.IsEmpty)
            return;
        await WriteAllAsync(
        [
            .. change.EntryFields.Count > 0 ? [new LocalEdit(SyncedEntities.TemplateEntry, entry.Id, OpKind.Update, change.EntryFields)] : Array.Empty<LocalEdit>(),
            .. change.RemoveChoices.Select(c => new LocalEdit(SyncedEntities.TemplateChoice, c, OpKind.Delete, [])),
            .. ChoiceCreates(entry.Id, change.AddMeals),
        ]);
    }

    /// <summary>
    /// A choice row per meal, ids a millisecond apart: rows list by id, so the meals keep the order they were given in.
    /// </summary>
    private static IEnumerable<LocalEdit> ChoiceCreates(Guid entry, IReadOnlyList<Guid> meals)
    {
        DateTimeOffset now = DateTimeOffset.UtcNow;
        return meals.Select((meal, i) => new LocalEdit(SyncedEntities.TemplateChoice, Guid.CreateVersion7(now.AddMilliseconds(i)), OpKind.Create,
        [
            new OpField(TemplateChoiceRules.EntryField, OpValues.FormatId(entry)),
            new OpField(TemplateChoiceRules.MealField, OpValues.FormatId(meal)),
        ]));
    }

    private async Task EditPlan()
    {
        List<TemplateEntry> entries = [.. _plans.EntriesOf(Id)];
        PlanEditorResult? result = await PlanDialogs.EditPlanAsync(Dialogs, Viewport, _template!.Name, _template.WeekCount,
            [.. _plans.Templates.Where(t => t.Id != Id).Select(t => t.Name)],
            entries.GroupBy(e => e.Week).ToDictionary(g => g.Key, g => g.Count()));
        if (result is null)
            return;

        if (result.Delete)
        {
            // Its entries and their choices go too, one op each: nothing cascades on sync. One added elsewhere meanwhile
            // is left behind, shown nowhere.
            await WriteAllAsync(
            [
                new LocalEdit(SyncedEntities.PlanTemplate, Id, OpKind.Delete, []),
                .. entries.Select(e => new LocalEdit(SyncedEntities.TemplateEntry, e.Id, OpKind.Delete, [])),
                .. entries.SelectMany(e => _plans.ChoicesOf(e.Id)).Select(c => new LocalEdit(SyncedEntities.TemplateChoice, c.Id, OpKind.Delete, [])),
            ]);
            Navigation.NavigateTo("plans");
            return;
        }

        List<OpField> fields = [];
        if (result.Name != _template.Name)
            fields.Add(new OpField(PlanTemplateRules.NameField, result.Name));
        // Once on the calendar, from today on: the days before keep the rotation they were eaten by.
        if (result.Weeks != _template.WeekCount)
            fields.AddRange(_template.StartsOn is { } starts
                ? PlanTemplateRules.RotationChange(_template.Earlier, starts, _template.WeekCount, DateOnly.FromDateTime(DateTime.Now), starts, result.Weeks)
                : [new OpField(PlanTemplateRules.WeekCountField, OpValues.FormatInt(result.Weeks))]);
        if (fields.Count > 0)
            await WriteAsync(SyncedEntities.PlanTemplate, Id, OpKind.Update, fields);
    }
}
