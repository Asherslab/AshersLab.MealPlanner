@page "/receipts"
@using System.Globalization
@using AshersLab.MealPlanner.LocalData
@using AshersLab.MealPlanner.LocalData.Sync
@using AshersLab.MealPlanner.Shared.Data.Ingredients
@using AshersLab.MealPlanner.Shared.Data.Products
@using AshersLab.MealPlanner.Shared.Data.Receipts
@using AshersLab.MealPlanner.Shared.Data.Stores
@using AshersLab.MealPlanner.Shared.Data.Sync
@using AshersLab.MealPlanner.Shared.Domain
@using AshersLab.MealPlanner.Shared.Domain.Ingredients
@using AshersLab.MealPlanner.Shared.Domain.Prices
@using AshersLab.MealPlanner.Shared.Domain.Products
@using AshersLab.MealPlanner.Shared.Domain.Receipts
@using AshersLab.MealPlanner.Shared.Domain.Stores
@using AshersLab.MealPlanner.WASM.Data
@using AshersLab.MealPlanner.WASM.Features.Shopping
@using Microsoft.EntityFrameworkCore
@inherits LocalDataPage
@inject IJSRuntime JS
@inject ILogger<ReceiptsPage> Logger
@implements IAsyncDisposable

@*
    Receipts: a Woolworths invoice PDF or a Costco receipt read on this device (wwwroot/js/receipt-pdf.js gives a text PDF's
    runs, or the OCR of a picture's lines; Shared.Domain reads them), reviewed line by line, then imported as ops in one
    transaction. The file is never uploaded or stored: it is shown during the review, and dropped once the review ends
    (docs/modules/receipts/receipts.md).
*@

<PageTitle>Receipts - Meal Planner</PageTitle>

@*
    A tool, in three sheets: "Add a receipt" with the file pick as its one main action; while a receipt is open, its
    summary and then every line to check, ruled on one sheet, with Import at the foot; otherwise the receipts imported
    so far.
*@

<LocalDataGate Start="Start">
<div class="receipts">
    @if (_review is null)
    {
        <PadSheet Title="Add a receipt" Subtitle="Its prices update, and what came home goes into the pantry.">
            <div class="pick">
                <p class="pick-help">
                    A Woolworths invoice (the PDF from the order's page), a Woolworths eReceipt (the PDF the Woolworths app
                    saves after a shop in store) or a Costco receipt (the PDF the Costco app saves).
                    It is read on this device only, and not kept.
                </p>
                <label class="@($"file-pick{(_reading ? " busy" : "")}")">
                    <MudIcon Icon="@Icons.Material.Filled.UploadFile"/>
                    <span>@(_reading ? "Reading the receipt…" : "Choose a receipt PDF")</span>
                    <InputFile OnChange="Picked" accept=".pdf,application/pdf" class="file-input" data-testid="receipt-file" disabled="@_reading"/>
                </label>
                @if (_reading)
                {
                    @if (_progress is { } progress)
                    {
                        <p class="pick-progress" data-testid="receipt-ocr-progress">Reading the receipt's picture… @((int)(progress * 100))%</p>
                        <MudProgressLinear Value="@(progress * 100)" Color="Color.Primary" Class="mt-1"/>
                    }
                    else
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3"/>
                    }
                }
            </div>
        </PadSheet>
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3" data-testid="receipt-error">@_error</MudAlert>
    }

    @if (_done is not null)
    {
        <MudAlert Severity="Severity.Success" Class="mt-3" data-testid="receipt-done">@_done</MudAlert>
    }

    @if (_review is { } import && _lines is not null)
    {
        ParsedReceipt parsed = import.Parsed;
        string? totals = parsed.TotalsProblem();
        bool ocr = _spans is not null;
        bool receipt = ocr || _till;   // a receipt, not an online order's invoice
        <div class="receipt-summary" data-testid="receipt-summary" data-order="@parsed.OrderNumber" data-date="@parsed.PurchasedOn.ToString("yyyy-MM-dd")"
             data-store="@import.StoreId">
        <PadSheet Title="@($"{StoreName(import.StoreId)} · {ShoppingText.Day(parsed.PurchasedOn)} {parsed.PurchasedOn.Year}")"
                  Subtitle="@($"{(receipt ? "Receipt" : "Order")} {parsed.OrderNumber} · {parsed.Lines.Count} lines")">
        <div class="summary-body">
            <p class="summary-totals num" data-testid="receipt-totals">
                @if (parsed.Fees.Count > 0 || parsed.SubtotalCents != parsed.TotalCents)
                {
                    <span>Sub total @Money.Format(parsed.SubtotalCents)</span>
                    @foreach (ParsedFee fee in parsed.Fees.Where(f => f.AmountCents != 0))
                    {
                        <span data-testid="receipt-fee"> · @fee.Name @Money.Format(fee.AmountCents)</span>
                    }
                    <span> · </span>
                }
                <b>Total @Money.Format(parsed.TotalCents)</b>
                @if (parsed.ItemsSold is { } sold)
                {
                    <span data-testid="receipt-items-sold"> · @sold items sold</span>
                }
                @if (parsed.RefundCents is { } refund)
                {
                    <span> · refunded @Money.Format(refund)</span>
                }
            </p>
            @if (totals is null)
            {
                <p class="summary-ok" data-testid="receipt-totals-ok">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Size="Size.Small" Color="Color.Success"/>
                    @(parsed.ItemsSold is { } n ? $"The lines add up to the total, and to the {n} items sold." : "The lines add up to the sub total.")
                </p>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Class="mt-2" data-testid="receipt-totals-problem">
                    @totals @(ocr ? "Check the lines marked below against the receipt, and correct what was misread." : "It cannot be imported.")
                </MudAlert>
            }
            @* An old shop's food is long eaten: on its old date it would sit in the pantry, nothing planned since to use it up. *@
            <div class="mt-2" data-testid="receipt-into-pantry" data-on="@_intoPantry">
                <MudCheckBox T="bool" Value="_intoPantry" ValueChanged="v => _intoPantry = v" Dense="true">
                    Add this shop's food to the pantry
                </MudCheckBox>
                @if (!_intoPantry)
                {
                    <p class="lines-help">Prices only: @(ReceiptStock.IntoPantryByDefault(parsed.PurchasedOn, DateOnly.FromDateTime(DateTime.Now))
                        ? "nothing from it goes into the pantry." : "a shop this old is long eaten, so nothing from it goes into the pantry.")</p>
                }
            </div>
            @if (import.Earlier is { } earlier)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-2" data-testid="receipt-earlier">
                    This @(receipt ? "receipt" : "order") was imported already, on @ShoppingText.Day(earlier.ImportedOn) @earlier.ImportedOn.Year. It cannot be imported twice.
                </MudAlert>
            }
            @if (ocr && _editingTotal)
            {
                <div class="inset-form" data-testid="receipt-total-form">
                    <div class="d-flex flex-wrap gap-2">
                        <MudTextField T="string" @bind-Value="_editTotal" Label="Total" Variant="Variant.Outlined" Immediate="true" InputId="receipt-edit-total" Style="max-width: 9rem"/>
                        <MudTextField T="string" @bind-Value="_editSold" Label="Items sold" Variant="Variant.Outlined" Immediate="true" InputId="receipt-edit-sold" Style="max-width: 9rem"/>
                        <label class="native-select">
                            <span>Date</span>
                            <input type="date" value="@_editDate?.ToString("yyyy-MM-dd")" @onchange="e => _editDate = DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out DateOnly d) ? d : _editDate"
                                   data-testid="receipt-edit-date"/>
                        </label>
                    </div>
                    @if (_editProblem is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" data-testid="receipt-edit-problem">@_editProblem</MudText>
                    }
                    <div class="d-flex gap-2 mt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTotal" data-testid="receipt-total-save">Correct</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="() => _editingTotal = false">Cancel</MudButton>
                    </div>
                </div>
            }
            <div class="d-flex flex-wrap gap-1 mt-2 summary-tools">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Description" OnClick="ShowFile" data-testid="receipt-show-file">
                    @(_showingFile ? $"Hide the {(receipt ? "receipt" : "invoice")}" : $"Show the {(receipt ? "receipt" : "invoice")}")
                </MudButton>
                @if (ocr && !_editingTotal)
                {
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditTotal" data-testid="receipt-total-edit">Correct the total</MudButton>
                }
            </div>
            <div @ref="_fileView" class="@(_showingFile ? "mt-2 file-view" : "d-none")" data-testid="receipt-file-view"></div>
        </div>
        </PadSheet>
        </div>

        <PadSheet Title="Check each line" Class="mt-4">
        <p class="lines-help">
            What a line is decides what it prices and what goes into the pantry. A line matched once is matched by itself on
            the next receipt.@(ocr ? " Each line shows the part of the receipt it was read from: if a figure differs, correct it." : "")
        </p>

        <div @ref="_linesView">
        @foreach (LineState state in _lines)
        {
            ParsedLine line = state.Review.Line;
            string? sums = line.SumProblem();
            bool unsure = _unsure?.Contains(line.Position) == true;
            <div class="@($"receipt-line{(sums is not null || unsure ? " check" : "")}")" data-testid="receipt-line" data-position="@line.Position" data-match="@state.Review.Match.By"
                 data-choice="@state.Choice" data-kind="@KindOf(state)" data-code="@line.StoreCode" data-check="@(sums is not null || unsure)">
                <MudGrid Spacing="2">
                    @if (_spans?.GetValueOrDefault(line.Position) is { } spans)
                    {
                        <MudItem xs="12" md="5">
                            <div class="receipt-strips" data-testid="receipt-line-picture">
                                @foreach (PictureSpan span in spans)
                                {
                                    <canvas data-top="@span.Top.ToString(CultureInfo.InvariantCulture)" data-bottom="@span.Bottom.ToString(CultureInfo.InvariantCulture)"></canvas>
                                }
                            </div>
                        </MudItem>
                    }
                    <MudItem xs="12" md="@(_spans is null ? 12 : 7)">
                <div class="d-flex gap-2">
                    <div class="flex-grow-1 line-text">
                        <span class="line-desc" data-testid="receipt-line-desc">@line.Description</span>
                        <span class="line-amount num" data-testid="receipt-line-amount">
                            @(line.StoreCode is { } code ? $"#{code} · " : "")@Bought(line)
                        </span>
                    </div>
                    @if (state.Review.Match.By != MatchedBy.None && state.Choice == $"p:{state.Review.Match.ProductId}")
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" data-testid="receipt-line-matched">matched</MudChip>
                    }
                </div>
                @if (sums is not null || unsure)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1" data-testid="receipt-line-problem">
                        @(sums is not null ? $"Check this line: {sums}" : "Its amount could not be read, so it was worked out from the price: check it.")
                    </MudAlert>
                }
                @if (ocr && _editing == line.Position)
                {
                    <div class="inset-form" data-testid="receipt-line-form">
                        <MudTextField T="string" @bind-Value="_editDescription" Label="Description" Variant="Variant.Outlined" Immediate="true" InputId="receipt-edit-desc"/>
                        <div class="d-flex flex-wrap gap-2 mt-1">
                            <MudTextField T="string" @bind-Value="_editCode" Label="Item number" Variant="Variant.Outlined" Immediate="true" InputId="receipt-edit-code" Style="max-width: 9rem"/>
                            <MudTextField T="string" @bind-Value="_editQuantity" Label="Quantity" Variant="Variant.Outlined" Immediate="true" InputId="receipt-edit-qty" Style="max-width: 6rem"/>
                            <MudTextField T="string" @bind-Value="_editPrice" Label="Price" Variant="Variant.Outlined" Immediate="true" InputId="receipt-edit-price" Style="max-width: 7rem"/>
                            <MudTextField T="string" @bind-Value="_editAmount" Label="Amount" Variant="Variant.Outlined" Immediate="true" InputId="receipt-edit-amount" Style="max-width: 7rem"/>
                        </div>
                        @if (line.DiscountCents != 0)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Less its discount of @Money.Format(line.DiscountCents), read from its own line.</MudText>
                        }
                        @if (_editProblem is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error" data-testid="receipt-edit-problem">@_editProblem</MudText>
                        }
                        <div class="d-flex gap-2 mt-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveLine(line)" data-testid="receipt-line-save">Correct</MudButton>
                            <MudButton Variant="Variant.Text" OnClick="() => _editing = null">Cancel</MudButton>
                        </div>
                    </div>
                }
                else if (ocr)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" Class="mt-1 line-correct" OnClick="() => EditLine(line)"
                               data-testid="receipt-line-edit">Correct what was read</MudButton>
                }
                @* The best guess, one tap: a product, or - the first time something is bought - a new product of an ingredient
                   ("Ayam Red Curry Paste 185g" is curry paste), its pack read from the description. *@
                @if (state.Choice == "" && state.Review.Match.Suggestions.FirstOrDefault(s => s.ProductId is not null || s.IngredientId is not null) is { } guess)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2 line-suggest"
                               OnClick="@(() => Choose(state, guess.ProductId is { } p ? "p:" + p : "n:" + guess.IngredientId))" data-testid="receipt-line-suggest">
                        Is it @guess.Name?
                    </MudButton>
                }
                <label class="native-select mt-2 d-block">
                    <span>It is</span>
                    <select value="@state.Choice" @onchange="e => Choose(state, e.Value?.ToString())" data-testid="receipt-line-choice">
                        <option value="">Not matched yet</option>
                        @if (state.Review.Match.Suggestions.Count > 0)
                        {
                            <optgroup label="Suggested">
                                @foreach (MatchSuggestion s in state.Review.Match.Suggestions)
                                {
                                    <option value="@(s.ProductId is { } p ? $"p:{p}" : $"n:{s.IngredientId}")">@(s.ProductId is null ? $"New product of {s.Name}" : s.Name)</option>
                                }
                            </optgroup>
                        }
                        <optgroup label="@($"{StoreName(import.StoreId)} products")">
                            @foreach (Product p in _products)
                            {
                                <option value="p:@p.Id">@p.Name</option>
                            }
                        </optgroup>
                        <optgroup label="A new product of">
                            @foreach (Ingredient i in _ingredients)
                            {
                                <option value="n:@i.Id">@i.Name</option>
                            }
                        </optgroup>
                        <option value="h">A new product, not food</option>
                        <option value="x">Leave it out</option>
                    </select>
                </label>
                @if (ReviewChoice.MakesProduct(state.Choice))
                {
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <MudTextField T="string" @bind-Value="state.NewName" Label="Product name" Variant="Variant.Outlined" Immediate="true"
                                      MaxLength="Names.MaxLength" Class="flex-grow-1" InputId="@($"receipt-new-name-{line.Position}")" data-testid="receipt-line-new-name"/>
                        <MudTextField T="string" @bind-Value="state.NewPack" Label="@($"Pack size ({UnitOf(state).Symbol()})")" Variant="Variant.Outlined"
                                      Immediate="true" Style="max-width: 10rem" InputId="@($"receipt-new-pack-{line.Position}")" data-testid="receipt-line-new-pack"
                                      HelperText="@PackHelp(state)"/>
                    </div>
                }
                @if (state.Tick is { } tick && _intoPantry)
                {
                    <div data-testid="receipt-line-cover" data-on="@state.Cover">
                        <MudCheckBox T="bool" Value="state.Cover" ValueChanged="v => { state.Cover = v; }" Dense="true" Class="mt-1">
                            Replaces the shopping list's tick of @ShoppingText.Day(tick.On) (@Quantity.Format(tick.Quantity, UnitOf(state)))
                        </MudCheckBox>
                    </div>
                }
                <p class="line-will" data-testid="receipt-line-will">@Will(state)</p>
                    </MudItem>
                </MudGrid>
            </div>
        }
        </div>

        <div class="receipt-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanImport)" OnClick="Import" data-testid="receipt-import">
                Import @_lines.Count lines
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="Cancel" data-testid="receipt-cancel">Cancel</MudButton>
        </div>
        </PadSheet>
    }

    @if (_review is null)
    {
        <PadSheet Title="Imported receipts" Class="mt-4">
            @if (_receipts.Count == 0)
            {
                <p class="pad-note">None yet - a receipt you add above shows here once it is imported.</p>
            }
            @foreach (ReceiptRow row in _receipts)
            {
                <PadRow Label="@StoreName(row.Receipt.StoreId)" TestId="receipt-row" DataId="@row.Receipt.Id.ToString()">
                    <div class="imported-line">
                        <span class="imported-day">@ShoppingText.Day(row.Receipt.PurchasedOn) @row.Receipt.PurchasedOn.Year</span>
                        <span class="imported-total">@Money.Format(row.Receipt.TotalCents)</span>
                    </div>
                    <div class="pad-entry-meta">
                        @row.Lines lines · @row.Unmatched not matched · imported @ShoppingText.Day(row.Receipt.ImportedOn)
                    </div>
                </PadRow>
            }
        </PadSheet>
    }
</div>
</LocalDataGate>

@code {
    private const long MaxFileBytes = 10 * 1024 * 1024;

    private sealed record ReceiptRow(Receipt Receipt, int Lines, int Unmatched);

    /// <summary>One line's review: the planner's choice, a new product's name and pack, and the tick it would replace.</summary>
    private sealed class LineState(ReviewLine review)
    {
        public ReviewLine Review { get; } = review;

        /// <summary>"" not matched, "p:{product}", "n:{ingredient}" a new product of it, "h" a new household product, "x" left out.</summary>
        public string Choice { get; set; } = review.Match.ProductId is { } p ? $"p:{p}" : "";

        public string? NewName { get; set; }

        public string? NewPack { get; set; }

        public TickBought? Tick { get; set; }

        public bool Cover { get; set; } = true;
    }

    private IJSObjectReference? _module;
    private DotNetObjectReference<ReceiptsPage>? _self;
    private ReceiptImport? _review;

    // "Add this shop's food to the pantry": on for a shop in the last week, off for an older one (ReceiptStock.IntoPantryByDefault).
    private bool _intoPantry = true;
    private List<LineState>? _lines;
    private List<Store> _stores = [];
    private List<Product> _products = [];
    private List<Ingredient> _ingredients = [];
    private List<ReceiptRow> _receipts = [];
    private ElementReference _fileView, _linesView;
    private bool _showingFile, _reading, _busy;
    private string? _error, _done;
    private double? _progress;

    // A Woolworths eReceipt from the till, not an online order's invoice: worded "receipt".
    private bool _till;

    // A picture's receipt (Costco): where each line was read from, and the lines whose amount OCR could not read.
    private IReadOnlyDictionary<int, IReadOnlyList<PictureSpan>>? _spans;
    private IReadOnlySet<int>? _unsure;

    // The correction open: a line's (by position) or the total's.
    private int? _editing;
    private bool _editingTotal;
    private string? _editDescription, _editCode, _editQuantity, _editPrice, _editAmount, _editTotal, _editSold, _editProblem;
    private DateOnly? _editDate;

    protected override async Task LoadAsync(LocalDbContext db)
    {
        _stores = [.. (await db.Stores.AsNoTracking().Where(s => !s.Deleted).ToListAsync()).OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase)];
        _ingredients = [.. (await db.Ingredients.AsNoTracking().Where(i => !i.Deleted).ToListAsync()).OrderBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase)];
        List<ReceiptLine> lines = await db.ReceiptLines.AsNoTracking().Where(l => !l.Deleted).ToListAsync();
        _receipts = [.. (await db.Receipts.AsNoTracking().Where(r => !r.Deleted).ToListAsync())
            .OrderByDescending(r => r.PurchasedOn)
            .Select(r => new ReceiptRow(r, lines.Count(l => l.ReceiptId == r.Id && l.Kind != ReceiptLineKind.Fee),
                lines.Count(l => l.ReceiptId == r.Id && l.ProductId is null && l.Kind is ReceiptLineKind.Food or ReceiptLineKind.Household)))];
        if (_review is not null)
            _products = [.. (await db.Products.AsNoTracking().Where(p => !p.Deleted && p.StoreId == _review.StoreId).ToListAsync())
                .OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase)];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (_spans is not null && _module is not null)
            await _module.InvokeVoidAsync("strips", _linesView);
    }

    private string StoreName(Guid id) => _stores.FirstOrDefault(s => s.Id == id)?.Name ?? "Store removed";

    private async Task<IJSObjectReference> Module() => _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/receipt-pdf.js");

    /// <summary>OCR's progress, 0 to 1, from <c>receipt-pdf.js</c>.</summary>
    [JSInvokable]
    public Task Progress(double at)
    {
        _progress = at;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>The latest pick: an earlier one still reading gives way to it and leaves the page to it.</summary>
    private int _pick;

    private async Task Picked(InputFileChangeEventArgs e)
    {
        int pick = ++_pick;
        (_error, _done, _reading, _progress) = (null, null, true, null);
        try
        {
            byte[] bytes;
            await using (Stream stream = e.File.OpenReadStream(MaxFileBytes))
            using (MemoryStream copy = new())
            {
                await stream.CopyToAsync(copy);
                bytes = copy.ToArray();
            }
            IJSObjectReference module = await Module();
            string text = await module.InvokeAsync<string>("read", bytes, pick);
            if (pick != _pick)
                return;   // picked again while this one was reading: the later one's document is the open one now
            List<PdfPage> pages = PdfJson.Read(text);

            // The reader names the store, by its seeded id: never a name, never a choice - a receipt's id is derived from it.
            if (WoolworthsInvoice.Recognises(pages) || WoolworthsEReceipt.Recognises(pages))
            {
                _till = !WoolworthsInvoice.Recognises(pages);
                ParsedReceipt parsed = _till ? WoolworthsEReceipt.Parse(pages) : WoolworthsInvoice.Parse(pages);
                (_spans, _unsure) = (null, null);
                await OpenAsync(Store(StoreRules.Woolworths, "Woolworths"), parsed);
                return;
            }
            if (pages.Any(p => p.Items.Count > 0))
                throw new ReceiptFormatException("This is not a Woolworths invoice or eReceipt, or a Costco receipt.");

            // A picture, no text: read it with OCR, here on this device.
            _progress = 0;
            StateHasChanged();
            _self ??= DotNetObjectReference.Create(this);
            List<OcrLine> lines = OcrJson.Read(await module.InvokeAsync<string>("ocr", _self));
            if (!CostcoReceipt.Recognises(lines))
                throw new ReceiptFormatException("This picture is not a Costco receipt this app can read.");
            CostcoRead read = CostcoReceipt.Parse(lines);
            (_spans, _unsure) = (read.Spans, read.Unsure);
            await OpenAsync(Store(StoreRules.Costco, "Costco"), read.Receipt);
        }
        catch (Exception ex) when (ex is ReceiptFormatException or IOException or JSException && pick != _pick)
        {
            // A later pick replaced this one (receipt-pdf.js destroyed its document): its outcome is the one shown.
        }
        catch (Exception ex) when (ex is ReceiptFormatException or IOException or JSException)
        {
            if (ex is JSException)
                Logger.LogWarning("Could not read the receipt PDF: {Message}", ex.Message);
            _error = ex is IOException ? "That file is too big to be a receipt." : ex is JSException ? "That file is not a PDF this device can read." : ex.Message;
            (_spans, _unsure) = (null, null);
            await Forget();
        }
        finally
        {
            if (pick == _pick)
                (_reading, _progress) = (false, null);
        }
    }

    private Guid Store(Guid id, string name) =>
        _stores.Any(s => s.Id == id) ? id : throw new ReceiptFormatException($"The {name} store was deleted, so its receipts cannot be imported.");

    private async Task OpenAsync(Guid store, ParsedReceipt parsed)
    {
        // A correction re-opens the review: the planner's choices so far are kept, by line - unless the line is now another item.
        Dictionary<int, LineState> before = _lines?.ToDictionary(l => l.Review.Line.Position) ?? [];
        if (_lines is null)   // a new receipt, not a correction: the default for its date
            _intoPantry = ReceiptStock.IntoPantryByDefault(parsed.PurchasedOn, DateOnly.FromDateTime(DateTime.Now));
        await using (LocalDbContext db = await Database.Contexts.CreateDbContextAsync())
            _review = await ReceiptImport.LoadAsync(db, store, parsed);
        _lines = [.. _review.Review().Select(r => before.GetValueOrDefault(r.Line.Position) is { } old && ReviewChoice.Survives(old.Review.Line, r.Line)
            ? new LineState(r) { Choice = old.Choice, NewName = old.NewName, NewPack = old.NewPack, Cover = old.Cover }
            : new LineState(r))];
        await Reload();
        Covers();
    }

    private void EditLine(ParsedLine line)
    {
        (_editing, _editingTotal, _editProblem) = (line.Position, false, null);
        _editDescription = line.Description;
        _editCode = line.StoreCode;
        _editQuantity = line.Supplied.ToString("0.##", CultureInfo.InvariantCulture);
        _editPrice = line.UnitPriceCents is { } u ? Money.Editable(u) : "";
        _editAmount = line.AmountCents > 0 ? Money.Editable(line.AmountCents) : "";
    }

    private async Task SaveLine(ParsedLine line)
    {
        if (_review is null)
            return;
        if (ReceiptCorrection.Line(line, _editDescription, _editCode, _editQuantity, _editPrice, _editAmount, out _editProblem) is not { } corrected)
            return;
        _unsure = _unsure?.Where(p => p != line.Position).ToHashSet();
        _editing = null;
        await OpenAsync(_review.StoreId, _review.Parsed.WithLine(corrected));
    }

    private void EditTotal()
    {
        if (_review is null)
            return;
        (_editingTotal, _editing, _editProblem) = (true, null, null);
        _editTotal = Money.Editable(_review.Parsed.TotalCents);
        _editSold = _review.Parsed.ItemsSold?.ToString(CultureInfo.InvariantCulture);
        _editDate = _review.Parsed.PurchasedOn;
    }

    private async Task SaveTotal()
    {
        if (_review is null)
            return;
        if (ReceiptCorrection.Receipt(_review.Parsed, _editTotal, _editSold, _editDate, out _editProblem) is not { } corrected)
            return;
        _editingTotal = false;
        await OpenAsync(_review.StoreId, corrected);
    }

    private void Choose(LineState state, string? choice)
    {
        state.Choice = choice ?? "";
        if (ReviewChoice.MakesProduct(state.Choice))
        {
            state.NewName ??= ReceiptImport.Clip(state.Review.Line.Description, Names.MaxLength);
            BaseUnit unit = UnitOf(state);
            state.NewPack = (state.Choice == "h" ? 1 : ReceiptMatching.PackGuess(state.Review.Line.Description, unit)) is { } pack
                ? PackSize.Editable(pack, unit) : state.NewPack;
        }
        Covers();
    }

    /// <summary>Which tick each line's purchase replaces, top to bottom, one line per tick.</summary>
    private void Covers()
    {
        if (_review is null || _lines is null)
            return;
        HashSet<Guid> taken = [];
        foreach (LineState state in _lines)
        {
            (Guid? product, Guid? ingredient) = Target(state);
            Guid? tick = state.Choice is "" or "x" ? null : _review.CoverFor(state.Review.Line, product, taken, ingredient);
            state.Tick = tick is { } t ? _review.Ticks.First(x => x.ItemId == t) : null;
            if (tick is { } c)
                taken.Add(c);
        }
    }

    private static (Guid? Product, Guid? Ingredient) Target(LineState state) => ReviewChoice.Target(state.Choice);

    private BaseUnit UnitOf(LineState state)
    {
        (Guid? product, Guid? ingredient) = Target(state);
        return (ingredient is { } i ? _review?.Ingredients.GetValueOrDefault(i) : _review?.IngredientOf(product))?.BaseUnit ?? BaseUnit.Each;
    }

    private string? PackHelp(LineState state)
    {
        decimal? pack = PackSize.Parse(state.NewPack, UnitOf(state), out string? problem);
        return pack is { } p ? $"= {PackSize.Format(p, UnitOf(state))}" : problem;
    }

    private LineDecision? DecisionOf(LineState state) =>
        ReviewChoice.Decide(state.Choice, state.NewName, state.NewPack, UnitOf(state), state.Tick?.ItemId, state.Cover);

    private ReceiptLineKind KindOf(LineState state) =>
        DecisionOf(state) is { } d && _review is not null ? _review.KindOf(state.Review.Line, d) : ReceiptLineKind.Food;

    private bool CanImport => !_busy && _editing is null && !_editingTotal && _review is { Earlier: null } r && r.Parsed.TotalsProblem() is null
                              && _lines!.All(l => DecisionOf(l) is not null);

    private static string Bought(ParsedLine line) =>
        line.NotSupplied ? $"not supplied{(line.Substitute ? "" : " - nothing came home")}"
        : line.WeightGrams is { } g ? $"{Quantity.Format(g, BaseUnit.Gram)} at {Money.Format(line.PerKgCents ?? 0)}/kg = {Money.Format(line.AmountCents)}"
        : $"{line.Supplied:0.##} × {Money.Format(line.UnitPriceCents ?? 0)} = {Money.Format(line.AmountCents)}"
          + (line.Substitute ? " · a substitute" : "") + (line.DiscountCents > 0 ? $" · {Money.Format(line.DiscountCents)} off" : "") + (line.Gst ? " · GST" : "");

    /// <summary>What importing does with the line, in the planner's words.</summary>
    private string Will(LineState state)
    {
        ParsedLine line = state.Review.Line;
        if (DecisionOf(state) is not { } decision)
            return "Give the new product a name and a pack size.";
        if (decision.Ignore)
            return "Left out.";
        if (decision.ProductId is null && decision.New is null)
            return "Not matched: imported, but it prices nothing and adds nothing to the pantry.";
        if (line.NotSupplied)
            return "Nothing came home: no price, nothing into the pantry.";
        string price = line.PackPriceCents is { } c ? $"Prices it at {Money.Format(c)} a pack" : "No price";
        (Guid? product, Guid? ingredientId) = Target(state);
        Ingredient? ingredient = ingredientId is { } i ? _review!.Ingredients.GetValueOrDefault(i) : _review!.IngredientOf(product);
        if (ingredient is null)
            return $"{price}. Not food: nothing into the pantry.";
        if (ingredient.IsStaple)
            return $"{price}. {ingredient.Name} is a staple: its stock is what you set on the pantry page.";
        if (!_intoPantry)
            return $"{price}. Not into the pantry.";
        decimal pack = decision.New?.PackQuantity ?? (product is { } p ? _review.Products.GetValueOrDefault(p)?.PackQuantity ?? 0 : 0);
        return ReceiptStock.Quantity(line, pack, ingredient.BaseUnit) is { } q
            ? $"{price}; {Quantity.Format(q, ingredient.BaseUnit)} of {ingredient.Name} into the pantry."
            : $"{price}.";
    }

    private async Task Import()
    {
        if (_review is null || _lines is null || !CanImport)
            return;
        _busy = true;
        try
        {
            // Read again just before writing: the same order may have arrived from another phone since the review opened.
            ReceiptImport fresh;
            await using (LocalDbContext db = await Database.Contexts.CreateDbContextAsync())
                fresh = await ReceiptImport.LoadAsync(db, _review.StoreId, _review.Parsed);
            if (fresh.Earlier is not null)
            {
                _review = fresh;
                return;
            }
            List<LineDecision> decisions = [.. _lines.Select(l => DecisionOf(l)!)];
            List<ReceiptEdit> edits = fresh.Edits(decisions, DateOnly.FromDateTime(DateTime.Now), Guid.CreateVersion7, _intoPantry);
            await WriteAllAsync([.. edits.Select(e => new LocalEdit(e.Type, e.Id, e.Kind, e.Fields))]);
            int prices = edits.Count(e => e.Type == SyncedEntities.PriceObservation);
            int stock = edits.Count(e => e.Type == SyncedEntities.StockMovement);
            int unmatched = decisions.Count(d => d is { ProductId: null, New: null, Ignore: false });
            _done = $"Imported {_review.Parsed.Lines.Count} lines: {prices} prices, {stock} into the pantry"
                    + (unmatched > 0 ? $", {unmatched} not matched." : ".");
            await Close();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Cancel()
    {
        (_error, _done) = (null, null);
        await Close();
    }

    private async Task Close()
    {
        (_review, _lines, _showingFile, _spans, _unsure, _editing, _editingTotal) = (null, null, false, null, null, null, false);
        await Forget();
        await Reload();
    }

    private async Task ShowFile()
    {
        _showingFile = !_showingFile;
        if (_showingFile)
        {
            StateHasChanged();
            await (await Module()).InvokeVoidAsync("show", _fileView);
        }
    }

    private async Task Forget()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("forget");
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("forget");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
