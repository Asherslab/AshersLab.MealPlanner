@page "/pantry"
@using AshersLab.MealPlanner.LocalData
@using AshersLab.MealPlanner.Shared.Data.Categories
@using AshersLab.MealPlanner.Shared.Data.Ingredients
@using AshersLab.MealPlanner.Shared.Data.Meals
@using AshersLab.MealPlanner.Shared.Data.Pantry
@using AshersLab.MealPlanner.Shared.Data.Products
@using AshersLab.MealPlanner.Shared.Data.Sync
@using AshersLab.MealPlanner.Shared.Domain
@using AshersLab.MealPlanner.Shared.Domain.Ingredients
@using AshersLab.MealPlanner.Shared.Domain.Pantry
@using AshersLab.MealPlanner.Shared.Domain.Sync
@using AshersLab.MealPlanner.WASM.Data
@using AshersLab.MealPlanner.WASM.Features.Ingredients
@using Microsoft.EntityFrameworkCore
@inherits LocalDataPage
@inject IDialogService Dialogs
@inject IBrowserViewportService Viewport

@*
    What is in the kitchen: every ingredient with stock, by category, with about how much there is now and when the plan
    uses the last of it; then the staples, each one tap from Have / Running low / Out. Tap an ingredient to put its stock
    right (PantrySheet). Search for one that is not here yet to add what you have. Stock is counted from the movements and
    the calendar (PantryBook) - nothing on this page is stored but the movements and the staples' state.
*@

<PageTitle>Pantry - Meal Planner</PageTitle>

<div class="pantry">
<LocalDataGate Start="Start" Title="@SheetTitle" Subtitle="@SheetSubtitle">
    <PadSheet Title="@SheetTitle" Subtitle="@SheetSubtitle" TestId="pantry-list">
        <div class="pantry-search">
            <MudTextField T="string" @bind-Value="_search" Label="Find an ingredient" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" MaxLength="Names.MaxLength"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          InputId="pantry-search" data-testid="pantry-search"/>
        </div>

        @if (_pantry is not null && !Groups().Any() && Staples().Count == 0 && Filter.Length == 0)
        {
            <p class="pad-note pantry-empty" data-testid="pantry-empty">
                Nothing counted yet - find an ingredient above and say how much you have.
            </p>
        }
        else if (_pantry is not null && Filter.Length > 0 && !Groups().Any() && Untracked().Count == 0 && Staples().Count == 0)
        {
            <p class="pad-note pantry-empty">
                Nothing called that. Check the spelling, or add it on <a href="ingredients">Ingredients</a> first.
            </p>
        }

        @foreach ((string heading, List<Ingredient> items) in Groups())
        {
            <h3 class="pantry-group" data-testid="pantry-group">@heading</h3>
            @foreach (Ingredient ingredient in items)
            {
                StockLevel now = _pantry!.At(ingredient.Id, Today);
                <div class="pantry-row" @key="ingredient.Id" role="button" tabindex="0"
                     @onclick="() => Open(ingredient)" data-testid="pantry-row" data-id="@ingredient.Id">
                    <span class="pantry-what">
                        <span class="pantry-name" data-testid="pantry-name">@ingredient.Name</span>
                        <span class="pantry-detail" data-testid="pantry-detail">@Detail(ingredient)</span>
                    </span>
                    <span class="@($"pantry-level{(now.State is StockState.InStock ? "" : " low")}")"
                          data-testid="pantry-level" data-state="@now.State">@PantryText.Level(now, ingredient.BaseUnit)</span>
                </div>
            }
        }

        @if (Untracked() is { Count: > 0 } untracked)
        {
            <h3 class="pantry-group">Not counted yet</h3>
            @foreach (Ingredient ingredient in untracked)
            {
                <div class="pantry-row" @key="ingredient.Id" role="button" tabindex="0"
                     @onclick="() => Open(ingredient)" data-testid="pantry-untracked" data-id="@ingredient.Id">
                    <span class="pantry-what"><span class="pantry-name">@ingredient.Name</span></span>
                    <span class="pantry-add"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small"/></span>
                </div>
            }
        }

        @if (Staples() is { Count: > 0 } staples)
        {
            <h3 class="pantry-group" data-testid="pantry-staples">Staples</h3>
            @foreach (Ingredient staple in staples)
            {
                <div class="pantry-row pantry-staple" @key="staple.Id" data-testid="pantry-staple" data-id="@staple.Id">
                    <span class="pantry-what"><span class="pantry-name" data-testid="pantry-staple-name">@staple.Name</span></span>
                    <div class="pantry-states" role="group" aria-label="@($"{staple.Name}: have, running low or out")">
                        @foreach (StapleStock state in Enum.GetValues<StapleStock>())
                        {
                            bool chosen = staple.StapleStock == state;
                            <MudButton Size="Size.Small" Variant="@(chosen ? Variant.Filled : Variant.Outlined)"
                                       Color="@(chosen ? state == StapleStock.Have ? Color.Primary : Color.Warning : Color.Default)"
                                       Class="pantry-state" aria-pressed="@(chosen ? "true" : "false")"
                                       OnClick="() => SetStaple(staple, state)"
                                       data-testid="pantry-staple-state" data-state="@state" data-chosen="@(chosen ? "true" : "false")">@state.Label()</MudButton>
                        }
                    </div>
                </div>
            }
        }
    </PadSheet>
</LocalDataGate>
</div>

@code {
    // The sheet's head, which LocalDataGate also shows while the page loads.
    private const string SheetTitle    = "Pantry";
    private const string SheetSubtitle = "About how much is at home. Tap one to put it right.";

    /// <summary>How far ahead the plan is drawn down: "runs out" looks a week ahead, the sheet's "coming up" two.</summary>
    private const int AheadDays = 14;

    private PantryBook?               _pantry;
    private List<Category>            _categories = [];
    private ILookup<Guid?, Product>   _products   = Array.Empty<Product>().ToLookup(p => p.IngredientId);
    private Dictionary<Guid, string>  _meals      = [];

    private string? _search;

    /// <summary>The day it is where the planner is: "now".</summary>
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    protected override async Task LoadAsync(LocalDbContext db)
    {
        _pantry     = await PantryBook.LoadAsync(db, Today, Today.AddDays(AheadDays));
        _categories = [.. CategoryEntity.InOrder(await db.Categories.AsNoTracking().Where(c => !c.Deleted).ToListAsync())];
        _products   = (await db.Products.AsNoTracking().Where(p => !p.Deleted && p.IngredientId != null).ToListAsync()).ToLookup(p => p.IngredientId);
        _meals      = await db.Meals.AsNoTracking().Where(m => !m.Deleted).ToDictionaryAsync(m => m.Id, m => m.Name);
    }

    private string Filter => Names.Normalise(_search);

    private bool Matches(Ingredient ingredient) => Filter.Length == 0 || ingredient.Name.Contains(Filter, StringComparison.CurrentCultureIgnoreCase);

    private IEnumerable<Ingredient> Live =>
        _pantry?.Ingredients.Values.OrderBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase) ?? Enumerable.Empty<Ingredient>();

    /// <summary>Ingredients with stock to show - anything counted or bought - under their category, then "No category".</summary>
    private IEnumerable<(string Heading, List<Ingredient> Items)> Groups()
    {
        if (_pantry is null)
            yield break;
        HashSet<Guid> tracked = [.. _pantry.Ledger.Tracked];
        List<Ingredient> shown = [.. Live.Where(i => !i.IsStaple && tracked.Contains(i.Id) && Matches(i))];

        HashSet<Guid> live = [.. _categories.Select(c => c.Id)];
        foreach (Category category in _categories)
            if (shown.Where(i => i.CategoryId == category.Id).ToList() is { Count: > 0 } items)
                yield return (category.Name, items);
        if (shown.Where(i => i.CategoryId is not { } id || !live.Contains(id)).ToList() is { Count: > 0 } loose)
            yield return ("No category", loose);
    }

    /// <summary>While searching: the ingredients that match and have no stock yet, to add some.</summary>
    private List<Ingredient> Untracked()
    {
        if (_pantry is null || Filter.Length == 0)
            return [];
        HashSet<Guid> tracked = [.. _pantry.Ledger.Tracked];
        return [.. Live.Where(i => !i.IsStaple && !tracked.Contains(i.Id) && Matches(i)).Take(10)];
    }

    private List<Ingredient> Staples() => [.. Live.Where(i => i.IsStaple && Matches(i))];

    /// <summary>"runs out Thu 29 Oct", "1 kg left after Sun 1 Nov", or nothing when the week's plan does not use it.</summary>
    private string Detail(Ingredient ingredient)
    {
        DateOnly weekOut = Today.AddDays(6);
        if (_pantry!.Ledger.RunsOut(ingredient.Id, Today, weekOut) is { } runsOut)
            return $"runs out {PantryText.Day(runsOut.Day)}";
        if (_pantry.UsesOf(ingredient.Id).LastOrDefault(u => u.Day >= Today && u.Day <= weekOut) is { } last
            && _pantry.Ledger.After(ingredient.Id, last.Day) is { State: StockState.InStock } after)
            return $"{Quantity.Format(after.Quantity, ingredient.BaseUnit)} left after {PantryText.Day(last.Day)}";
        return "";
    }

    /// <summary>The pack it is usually bought in: the smallest at its usual store, else the smallest anywhere.</summary>
    private decimal? PackOf(Ingredient ingredient)
    {
        List<Product> products = [.. _products[ingredient.Id].Where(p => p.PackQuantity > 0)];
        List<Product> usual = [.. products.Where(p => p.StoreId == ingredient.UsualStoreId)];
        return (usual.Count > 0 ? usual : products).Select(p => (decimal?)p.PackQuantity).Min();
    }

    private async Task Open(Ingredient ingredient)
    {
        bool phone = await Viewport.GetCurrentBreakpointAsync() < Breakpoint.Sm;
        StockLevel now = _pantry!.At(ingredient.Id, Today);
        string nowText = PantryText.Level(now, ingredient.BaseUnit);

        DialogParameters<PantrySheet> parameters = new()
        {
            { s => s.IngredientId, ingredient.Id },
            { s => s.Unit, ingredient.BaseUnit },
            { s => s.NowText, char.ToUpperInvariant(nowText[0]) + nowText[1..] + (now.State == StockState.InStock ? " now" : "") },
            { s => s.Pack, PackOf(ingredient) },
            { s => s.Today, Today },
            { s => s.Coming, (IReadOnlyList<string>)[.. _pantry.UsesOf(ingredient.Id).Where(u => u.Day >= Today)
                .Select(u => $"{PantryText.Day(u.Day)} · {_meals.GetValueOrDefault(u.MealId) ?? "meal removed"} · {Quantity.Format(u.Quantity, ingredient.BaseUnit)}")] },
            { s => s.History, (IReadOnlyList<PickerOption>)[.. _pantry.MovementsOf(ingredient.Id).Take(10)
                .Select(m => new PickerOption(m.Id, $"{PantryText.Day(m.OccurredOn)} · {PantryText.Movement(m.Reason, m.Quantity, ingredient.BaseUnit)}"))] },
        };
        DialogOptions options = new() { FullWidth = true, MaxWidth = MaxWidth.Small, FullScreen = phone, CloseOnEscapeKey = true };

        IDialogReference dialog = await Dialogs.ShowAsync<PantrySheet>(ingredient.Name, parameters, options);
        if (await dialog.Result is not { Canceled: false, Data: PantrySheetResult result })
            return;

        if (result.Entry is { } entry)
            await WriteAsync(SyncedEntities.StockMovement, Guid.CreateVersion7(), OpKind.Create, entry.Fields());
        else if (result.DeleteId is { } id)
            await WriteAsync(SyncedEntities.StockMovement, id, OpKind.Delete, []);
    }

    /// <summary>One tap: the staple's state, alone in its op. Tapping the state it already has sends nothing.</summary>
    private async Task SetStaple(Ingredient staple, StapleStock state)
    {
        if (staple.StapleStock == state)
            return;
        await WriteAsync(SyncedEntities.Ingredient, staple.Id, OpKind.Update,
            [new OpField(IngredientRules.StapleStockField, StapleStocks.Format(state))]);
    }
}
