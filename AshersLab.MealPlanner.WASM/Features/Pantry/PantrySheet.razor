@using AshersLab.MealPlanner.Shared.Domain.Ingredients
@using AshersLab.MealPlanner.Shared.Domain.Pantry
@using AshersLab.MealPlanner.WASM.Features.Ingredients

@*
    One ingredient's stock. The estimate drifts - recipes are approximate and nobody weighs the mayo - so putting it right
    is two taps: the ingredient, then what is there ("Out", "½ pack"). Each of those is a count, which sets the level
    rather than adding to it. Bought adds whole packs. For anything else, type an amount and say what it is. Beneath, what
    the plan takes from it next, and its history, where a mistaken entry can be deleted. Like the other sheets it only
    answers; the page writes the ops.
*@

<MudDialog data-testid="pantry-sheet">
    <DialogContent>
        <div class="pantry-sheet-body">
            <p class="sheet-now" data-testid="pantry-sheet-now">@NowText</p>

            <h3 class="sheet-heading">What's left?</h3>
            <div class="sheet-buttons">
                <MudButton Variant="Variant.Outlined" OnClick="() => Count(0)" data-testid="pantry-out">Out</MudButton>
                @if (Pack is { } pack)
                {
                    <MudButton Variant="Variant.Outlined" OnClick="() => Count(PantryText.Of(pack, 0.25m))" data-testid="pantry-quarter">¼ pack</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="() => Count(PantryText.Of(pack, 0.5m))" data-testid="pantry-half">½ pack</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="() => Count(pack)" data-testid="pantry-pack">1 pack</MudButton>
                }
            </div>
            @if (Pack is { } size)
            {
                <h3 class="sheet-heading">Bought</h3>
                <div class="sheet-buttons">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => Close(StockReason.Bought, size)"
                               data-testid="pantry-bought-1">+1 pack (@Quantity.Format(size, Unit))</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => Close(StockReason.Bought, size * 2)"
                               data-testid="pantry-bought-2">+2 packs</MudButton>
                </div>
            }

            <h3 class="sheet-heading">An amount</h3>
            <MudTextField T="string" @bind-Value="_amount" Label="@($"How much? {Quantity.Example(Unit)}")" Variant="Variant.Outlined"
                          Immediate="true" InputMode="@(InputMode.@decimal)" Error="_error is not null" ErrorText="@_error"
                          InputId="pantry-amount" data-testid="pantry-amount"/>
            <div class="sheet-buttons sheet-buttons-after">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => Typed(StockReason.Counted)"
                           data-testid="pantry-amount-count">That's what's left</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="() => Typed(StockReason.Bought)" data-testid="pantry-amount-bought">Bought this</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="() => Typed(StockReason.Adjusted)" data-testid="pantry-amount-threw">Threw this out</MudButton>
            </div>

            @if (Coming.Count > 0)
            {
                <h3 class="sheet-heading sheet-heading-gap">Coming up</h3>
                <div class="sheet-rows">
                    @foreach (string use in Coming)
                    {
                        <div class="sheet-row" data-testid="pantry-sheet-use">@use</div>
                    }
                </div>
            }

            <h3 class="sheet-heading sheet-heading-gap">History</h3>
            @if (History.Count == 0)
            {
                <p class="sheet-empty" data-testid="pantry-history-empty">Nothing yet.</p>
            }
            else
            {
                <div class="sheet-rows">
                    @foreach (PickerOption movement in History)
                    {
                        <div class="sheet-row" @key="movement.Id" data-testid="pantry-history-row" data-id="@movement.Id">
                            <span class="sheet-row-text">@movement.Name</span>
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" aria-label="@($"Delete: {movement.Name}")"
                                           OnClick="() => Dialog.Close(DialogResult.Ok(new PantrySheetResult(null, movement.Id)))"
                                           data-testid="pantry-history-delete"/>
                        </div>
                    }
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => Dialog.Cancel()" data-testid="pantry-cancel">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public Guid IngredientId { get; set; }

    [Parameter] public BaseUnit Unit { get; set; }

    /// <summary>"About 1.5 kg now", "Probably out".</summary>
    [Parameter] public string NowText { get; set; } = "";

    /// <summary>The pack it is usually bought in, when a product says; null hides the pack buttons.</summary>
    [Parameter] public decimal? Pack { get; set; }

    /// <summary>The day the browser thinks it is: every movement is written for it.</summary>
    [Parameter] public DateOnly Today { get; set; }

    /// <summary>"Thu 29 Oct · Stew · 500 g", in day order.</summary>
    [Parameter] public IReadOnlyList<string> Coming { get; set; } = [];

    /// <summary>Its movements, newest first, as "Wed 28 Oct · counted 250 g".</summary>
    [Parameter] public IReadOnlyList<PickerOption> History { get; set; } = [];

    private string? _amount;
    private string? _error;

    private void Count(decimal level) => Close(StockReason.Counted, level);

    private void Typed(StockReason reason)
    {
        decimal? amount = Quantity.Read(_amount, Unit, out _error);
        if (_error is not null)
            return;
        if (amount is not { } typed)
        {
            _error = "Type how much.";
            return;
        }
        // "Threw this out" types what went, and takes it off.
        Close(reason, reason == StockReason.Adjusted ? -typed : typed);
    }

    private void Close(StockReason reason, decimal quantity)
    {
        if (StockRules.QuantityProblem(reason, quantity) is { } problem)
        {
            _error = problem;
            return;
        }
        Dialog.Close(DialogResult.Ok(new PantrySheetResult(new StockEntry(IngredientId, quantity, Today, reason), null)));
    }
}
