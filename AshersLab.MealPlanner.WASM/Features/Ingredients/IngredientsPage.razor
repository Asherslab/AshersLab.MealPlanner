@page "/ingredients"
@using AshersLab.MealPlanner.LocalData
@using AshersLab.MealPlanner.LocalData.Sync
@using AshersLab.MealPlanner.Shared.Data.Ingredients
@using AshersLab.MealPlanner.Shared.Data.Sync
@using AshersLab.MealPlanner.Shared.Domain.Ingredients
@using AshersLab.MealPlanner.Shared.Domain.Sync
@using AshersLab.MealPlanner.WASM.Data
@using Microsoft.EntityFrameworkCore
@using SqliteWasmBlazor
@implements IDisposable
@inject LocalDatabase Database
@inject SyncLoop Sync

@*
    The op log's first page: add an ingredient, rename one. Reads and writes only this browser's database -
    every edit is an op (LocalOps.WriteAsync), and the sync loop carries it to the server and to every other
    device. Works the same offline. Full ingredient editing (unit, category, store) is slice 4.
*@

<PageTitle>Ingredients - Meal Planner</PageTitle>

<MudText Typo="Typo.h5" Component="h1">Ingredients</MudText>

@if (_start is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4"/>
}
else if (_start.State != DbInitState.READY)
{
    <MudAlert Severity="Severity.Error" Class="mt-4" data-testid="local-db-state">
        This browser could not open its copy of the data (@_start.State): @_start.Failure
    </MudAlert>
}
else
{
    <form class="d-flex align-start gap-2 mt-4" @onsubmit="Add" @onsubmit:preventDefault>
        <MudTextField T="string" @bind-Value="_newName" Label="New ingredient" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Immediate="true" MaxLength="IngredientRules.MaxNameLength"
                      Error="_addError is not null" ErrorText="@_addError"
                      InputId="ingredient-new-name" data-testid="ingredient-new-name"/>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-1"
                   data-testid="ingredient-add">Add</MudButton>
    </form>

    <MudPaper Outlined="true" Class="mt-4">
        @if (_ingredients.Count == 0)
        {
            <MudText Class="pa-4" Color="Color.Secondary" data-testid="ingredients-empty">No ingredients yet.</MudText>
        }
        @* Plain rows, not MudList: a MudListItem takes Space and Enter for its own selection, so a text box inside
           one loses every space typed and never submits. *@
        <div>
            @foreach (Ingredient ingredient in _ingredients)
            {
                <div class="ingredient-row px-4 py-2" @key="ingredient.Id" data-testid="ingredient-row" data-id="@ingredient.Id">
                    @if (_renaming == ingredient.Id)
                    {
                        <form class="d-flex align-start gap-2" @onsubmit="SaveRename" @onsubmit:preventDefault>
                            <MudTextField T="string" @bind-Value="_renameTo" Label="Name" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Immediate="true" AutoFocus="true"
                                          MaxLength="IngredientRules.MaxNameLength"
                                          Error="_renameError is not null" ErrorText="@_renameError"
                                          InputId="ingredient-rename-input" data-testid="ingredient-rename-input"/>
                            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled"
                                       Class="mt-1" data-testid="ingredient-rename-save">Save</MudButton>
                            <MudButton OnClick="CancelRename" Class="mt-1">Cancel</MudButton>
                        </form>
                    }
                    else
                    {
                        <div class="d-flex align-center">
                            <MudText Class="flex-grow-1" data-testid="ingredient-name">@ingredient.Name</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           aria-label="@($"Rename {ingredient.Name}")"
                                           OnClick="() => StartRename(ingredient)" data-testid="ingredient-rename"/>
                        </div>
                    }
                </div>
            }
        </div>
    </MudPaper>
}

@code {
    private LocalDatabaseStart? _start;
    private List<Ingredient>    _ingredients = [];

    private string? _newName;
    private string? _addError;

    private Guid?   _renaming;
    private string? _renameTo;
    private string? _renameError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _start = await Database.StartAsync();
        if (_start.State == DbInitState.READY)
        {
            Database.ChangedElsewhere += Reload;
            Sync.DataChanged          += Reload;
            await Reload();
        }
        StateHasChanged();
    }

    private async Task Reload()
    {
        await using LocalDbContext db = await Database.Contexts.CreateDbContextAsync();

        _ingredients = await db.Ingredients.AsNoTracking()
            .Where(i => !i.Deleted)
            .OrderBy(i => i.Name)
            .ToListAsync();

        await InvokeAsync(StateHasChanged);
    }

    private async Task Add()
    {
        string name = IngredientRules.NormaliseName(_newName);
        _addError = IngredientRules.NameProblem(name);
        if (_addError is not null)
            return;

        // Cleared before the write, not after: on a slow phone the next name is often typed while this one is
        // saving, and must go into an empty box rather than be appended to - or wiped with - this one.
        _newName = null;
        await Write(Guid.CreateVersion7(), OpKind.Create, name);
    }

    private void StartRename(Ingredient ingredient)
    {
        _renaming    = ingredient.Id;
        _renameTo    = ingredient.Name;
        _renameError = null;
    }

    private void CancelRename() => _renaming = null;

    private async Task SaveRename()
    {
        if (_renaming is not { } id)
            return;

        string name = IngredientRules.NormaliseName(_renameTo);
        _renameError = IngredientRules.NameProblem(name);
        if (_renameError is not null)
            return;

        _renaming = null;

        // Unchanged: no op. An op that changes nothing would still win the merge against a rename made
        // meanwhile on another device.
        if (_ingredients.FirstOrDefault(i => i.Id == id)?.Name != name)
            await Write(id, OpKind.Update, name);
    }

    private async Task Write(Guid id, OpKind kind, string name)
    {
        await using (LocalDbContext db = await Database.Contexts.CreateDbContextAsync())
            await LocalOps.WriteAsync(db, _start!.Device!.Id, DateTimeOffset.UtcNow, SyncedEntities.Ingredient, id, kind,
                [new OpField(IngredientRules.NameField, name)]);

        Sync.Kick();
        await Reload();
    }

    public void Dispose()
    {
        Database.ChangedElsewhere -= Reload;
        Sync.DataChanged          -= Reload;
    }
}
