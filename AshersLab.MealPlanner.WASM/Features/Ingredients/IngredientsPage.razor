@page "/ingredients"
@using AshersLab.MealPlanner.LocalData
@using AshersLab.MealPlanner.Shared.Data.Categories
@using AshersLab.MealPlanner.Shared.Data.Ingredients
@using AshersLab.MealPlanner.Shared.Data.Stores
@using AshersLab.MealPlanner.Shared.Data.Sync
@using AshersLab.MealPlanner.Shared.Domain
@using AshersLab.MealPlanner.Shared.Domain.Ingredients
@using AshersLab.MealPlanner.Shared.Domain.Sync
@using AshersLab.MealPlanner.WASM.Data
@using Microsoft.EntityFrameworkCore
@inherits LocalDataPage
@inject IDialogService Dialogs
@inject IBrowserViewportService Viewport

@*
    Every ingredient, grouped by category in the household's order. Type a name and tap Add (or Enter) to open the
    editor with it filled in; tap a row to edit or delete it. Reads and writes only this browser's database - every
    edit is an op, synced by the sync loop, and works the same offline.
*@

<PageTitle>Ingredients - Meal Planner</PageTitle>

<MudText Typo="Typo.h5" Component="h1">Ingredients</MudText>

<LocalDataGate Start="Start">
    <form class="d-flex align-start gap-2 mt-4" @onsubmit="Add" @onsubmit:preventDefault>
        <MudTextField T="string" @bind-Value="_newName" Label="New ingredient, or search" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Immediate="true" MaxLength="Names.MaxLength"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      InputId="ingredient-new-name" data-testid="ingredient-new-name"/>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-1"
                   data-testid="ingredient-add">Add</MudButton>
    </form>

    @if (_ingredients.Count == 0)
    {
        <MudText Class="pa-4 mud-text-secondary" data-testid="ingredients-empty">No ingredients yet.</MudText>
    }
    else if (!Groups().Any())
    {
        <MudText Class="pa-4 mud-text-secondary" data-testid="ingredients-none-match">
            None match "@Names.Normalise(_newName)". Tap Add to add it.
        </MudText>
    }

    @foreach ((string heading, List<Ingredient> items) in Groups())
    {
        <MudText Typo="Typo.overline" Component="h2" Class="mt-4 d-block" data-testid="ingredient-group">@heading</MudText>
        <MudPaper Outlined="true">
            @foreach (Ingredient ingredient in items)
            {
                <div class="ingredient-row px-4 py-2" @key="ingredient.Id" role="button" tabindex="0"
                     @onclick="() => Edit(ingredient)" data-testid="ingredient-row" data-id="@ingredient.Id">
                    <div class="d-flex align-center gap-2">
                        <MudText Class="flex-grow-1" data-testid="ingredient-name">@ingredient.Name</MudText>
                        @if (ingredient.UnitGuessed)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" data-testid="ingredient-unit-guessed">Check unit</MudChip>
                        }
                        @if (ingredient.IsStaple)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" data-testid="ingredient-staple-chip">Staple</MudChip>
                        }
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="ingredient-detail">
                        @Detail(ingredient)
                    </MudText>
                </div>
            }
        </MudPaper>
    }
</LocalDataGate>

@code {
    private List<Ingredient>          _ingredients = [];
    private List<Category>            _categories  = [];
    private Dictionary<Guid, string>  _stores      = [];
    private ILookup<Guid?, string>    _products    = Array.Empty<string>().ToLookup(_ => (Guid?)null);
    private ILookup<Guid?, string>    _meals       = Array.Empty<string>().ToLookup(_ => (Guid?)null);

    private string? _newName;

    protected override async Task LoadAsync(LocalDbContext db)
    {
        _ingredients = await db.Ingredients.AsNoTracking().Where(i => !i.Deleted).ToListAsync();
        _categories  = [.. CategoryEntity.InOrder(await db.Categories.AsNoTracking().Where(c => !c.Deleted).ToListAsync())];
        _stores      = (await db.Stores.AsNoTracking().Where(s => !s.Deleted).ToListAsync())
            .OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToDictionary(s => s.Id, s => s.Name);
        _products    = (await db.Products.AsNoTracking().Where(p => !p.Deleted && p.IngredientId != null).ToListAsync())
            .OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToLookup(p => p.IngredientId, p => p.Name);

        Dictionary<Guid, string> meals = await db.Meals.AsNoTracking().Where(m => !m.Deleted).ToDictionaryAsync(m => m.Id, m => m.Name);
        _meals = (await db.MealIngredients.AsNoTracking().Where(l => !l.Deleted).Select(l => new { l.IngredientId, l.MealId }).ToListAsync())
            .Where(l => meals.ContainsKey(l.MealId))
            .Select(l => (Ingredient: (Guid?)l.IngredientId, Meal: meals[l.MealId]))
            .Distinct()
            .OrderBy(l => l.Meal, StringComparer.CurrentCultureIgnoreCase)
            .ToLookup(l => l.Ingredient, l => l.Meal);
    }

    /// <summary>
    /// The ingredients matching the box, under their category's heading in category order; those with no category,
    /// or one that has been deleted, last under "No category".
    /// </summary>
    private IEnumerable<(string Heading, List<Ingredient> Items)> Groups()
    {
        string filter = Names.Normalise(_newName);
        List<Ingredient> shown = [.. _ingredients
            .Where(i => filter.Length == 0 || i.Name.Contains(filter, StringComparison.CurrentCultureIgnoreCase))
            .OrderBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase)];

        HashSet<Guid> live = [.. _categories.Select(c => c.Id)];
        foreach (Category category in _categories)
        {
            List<Ingredient> items = [.. shown.Where(i => i.CategoryId == category.Id)];
            if (items.Count > 0)
                yield return (category.Name, items);
        }

        List<Ingredient> loose = [.. shown.Where(i => i.CategoryId is not { } id || !live.Contains(id))];
        if (loose.Count > 0)
            yield return ("No category", loose);
    }

    private string Detail(Ingredient ingredient) =>
        string.Join(" · ", new[]
        {
            $"counted in {ingredient.BaseUnit.Symbol()}",
            ingredient.UsualStoreId is { } store ? _stores.GetValueOrDefault(store) ?? "store removed" : null,
        }.Where(s => s is not null));

    private async Task Add()
    {
        string name = Names.Normalise(_newName);
        IngredientEditorResult? result = await OpenEditor(new IngredientDraft(name, null, null, null, false), isNew: true, editing: null);
        if (result?.Saved is not { } draft)
            return;

        _newName = null;
        await WriteAsync(SyncedEntities.Ingredient, Guid.CreateVersion7(), OpKind.Create, draft.FieldsChangedFrom(null));
    }

    private async Task Edit(Ingredient ingredient)
    {
        IngredientDraft before = new(ingredient.Name, ingredient.BaseUnit, ingredient.CategoryId, ingredient.UsualStoreId, ingredient.IsStaple,
            ingredient.UnitGuessed);
        IngredientEditorResult? result = await OpenEditor(before, isNew: false, editing: ingredient.Id);

        if (result is { Delete: true })
            await WriteAsync(SyncedEntities.Ingredient, ingredient.Id, OpKind.Delete, []);
        else if (result?.Saved is { } draft && draft.FieldsChangedFrom(before) is { Count: > 0 } fields)
            await WriteAsync(SyncedEntities.Ingredient, ingredient.Id, OpKind.Update, fields);
    }

    private Task<IngredientEditorResult?> OpenEditor(IngredientDraft draft, bool isNew, Guid? editing) =>
        IngredientDialogs.EditAsync(Dialogs, Viewport, draft, isNew,
            [.. _categories.Select(c => new PickerOption(c.Id, c.Name))],
            [.. _stores.Select(s => new PickerOption(s.Key, s.Value))],
            [.. _ingredients.Where(i => i.Id != editing).Select(i => i.Name)],
            [.. _products[editing]], [.. _meals[editing]]);
}
