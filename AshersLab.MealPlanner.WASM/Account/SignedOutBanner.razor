@using AshersLab.MealPlanner.LocalData.Sync
@using AshersLab.MealPlanner.WASM.Sync
@implements IDisposable
@inject SyncLoop Sync
@inject NavigationManager Navigation

@*
    Across the top of every page while signed out: what it means (nothing lost; it waits on this device) and the way
    back in. Not on the sign-in pages themselves.
*@

@if (Sync.Status.Connection == SyncConnection.SignedOut && !OnSignInPage)
{
    <div class="signed-out" role="status" data-testid="signed-out">
        <span>You're signed out. Changes stay on this device and are sent once you sign in.</span>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Href="@SignInLink" data-testid="signed-out-sign-in">Sign in</MudButton>
    </div>
}

@code {
    private bool OnSignInPage => Navigation.ToBaseRelativePath(Navigation.Uri) is var path
                                 && (path.StartsWith("sign-in", StringComparison.Ordinal) || path.StartsWith("welcome", StringComparison.Ordinal));

    private string SignInLink => $"sign-in?back={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}";

    protected override void OnInitialized()
    {
        Sync.StatusChanged += Changed;
        Navigation.LocationChanged += Moved;
    }

    private Task Changed() => InvokeAsync(StateHasChanged);

    private void Moved(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Sync.StatusChanged -= Changed;
        Navigation.LocationChanged -= Moved;
    }
}
