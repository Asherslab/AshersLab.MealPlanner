@using AshersLab.MealPlanner.LocalData
@using AshersLab.MealPlanner.WASM.Data
@using Microsoft.EntityFrameworkCore
@using SqliteWasmBlazor
@implements IDisposable
@inject LocalDatabase Database

@*
    The browser database's proof of life: the Device row it keeps for this browser profile. The id staying put
    and the count going up across reloads and browser restarts is what "the database persists" looks like.
    Every window of the app shares the row, so opening a second window updates the count shown in the first.
    A quiet pad sheet of label-and-value rows (Diagnostics dresses it).
*@

<PadSheet Title="This device" Class="quiet" TestId="device-sheet">
    @if (_start is null)
    {
        <div class="device-note">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
        </div>
    }
    else if (_start.State == DbInitState.TAB_LOCKED)
    {
        <div class="device-note">
            <MudAlert Severity="Severity.Warning" data-testid="local-db-state">
                Another window is holding this browser's copy of the data and not sharing it. Close the other
                windows of the meal planner, then reload this one.
            </MudAlert>
        </div>
    }
    else if (_device is null)
    {
        @* The page's LocalDataGate says why, and offers the reset. *@
        <p class="pad-note" data-testid="device-not-open">
            This browser's copy of the data is not open (@_start.State) - see above.
        </p>
    }
    else
    {
        <PadRow Label="Device">
            <span class="diag-value num" data-testid="device-id">@_device.Id</span>
        </PadRow>
        <PadRow Label="First opened">
            <span class="diag-value num" data-testid="device-first-opened">@_device.FirstOpenedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
        </PadRow>
        <PadRow Label="Opened">
            <span class="diag-value num" data-testid="device-open-count">@_device.OpenCount @(_device.OpenCount == 1 ? "time" : "times")</span>
        </PadRow>
        <PadRow Label="Storage">
            <span class="diag-value" data-testid="device-storage">@StorageText(_start.StoragePersisted)</span>
        </PadRow>
        <PadRow Label="Held by">
            <span class="diag-value" data-testid="device-role">@RoleText(_role)</span>
        </PadRow>
    }
</PadSheet>

@code {
    private LocalDatabaseStart? _start;
    private Device?             _device;
    private string?             _role;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _start  = await Database.StartAsync();
        _device = _start.Device;
        if (_device is not null)
        {
            _role                     =  await Database.RoleAsync();
            Database.ChangedElsewhere += Refresh;
        }
        StateHasChanged();
    }

    private async Task Refresh()
    {
        await using LocalDbContext db = await Database.Contexts.CreateDbContextAsync();
        _device = await db.Devices.AsNoTracking().SingleAsync();
        _role   = await Database.RoleAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Database.ChangedElsewhere -= Refresh;

    private static string StorageText(bool? persisted) => persisted switch
    {
        true  => "Kept by the browser",
        false => "May be cleared by the browser if unused - the server copy restores it",
        null  => "This browser cannot promise to keep it",
    };

    private static string RoleText(string? role) => role switch
    {
        "leader"   => "This window",
        "follower" => "Another window of the app - shared",
        _          => "Not yet known",
    };
}
